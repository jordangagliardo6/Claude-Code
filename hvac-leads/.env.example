# ─────────────────────────────────────────────────────────────
# Apollo.io API Key
# Get from: https://developer.apollo.io/keys/
# ─────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────
# Google Sheets — Master spreadsheet (already exists in Drive)
# ID from: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# ─────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Sheet tab name inside the spreadsheet (check bottom of the sheet)
GOOGLE_SHEET_NAME=Untitled

# Path to your Google Service Account JSON credentials file
# See SETUP.md for how to create one
GOOGLE_KEY_FILE=./credentials/google-service-account.json

# ─────────────────────────────────────────────────────────────
# Scheduling & run limits
# ─────────────────────────────────────────────────────────────
# Cron: "0 7 * * *" = 7:00 AM. The scheduler runs in America/New_York timezone.
CRON_SCHEDULE=0 7 * * *

# Max new leads to pull per run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────────────────────
# Error notifications (optional)
# ─────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP settings — only needed if you enable email alerts in src/workflow.js
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=HVAC Leads Bot <you@gmail.com>
