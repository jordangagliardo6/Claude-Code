# ── Required ──────────────────────────────────────────────────────────────────

# Apollo.io API key
# Get it from: https://developer.apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Copy from the URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Path to your Google service account JSON credentials file
# See setup instructions in README.md for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-credentials.json

# ── Optional: Email alerts ─────────────────────────────────────────────────
# If set, errors are emailed to NOTIFICATION_EMAIL. Leave blank to disable.

# Where to send error alerts
NOTIFICATION_EMAIL=

# Gmail SMTP settings (use an App Password, not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
