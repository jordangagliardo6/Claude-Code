# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
# NOTE: People search requires the Basic plan ($49/mo) or higher.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tab (sheet) name within the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Choose ONE of the two auth methods below:

# Option A — Service Account (recommended for automated/unattended runs)
# Paste the full JSON from your service account key file as a single line.
# Create at: Google Cloud Console → IAM → Service Accounts → Keys
# Then share the spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B — OAuth2 (if you already have tokens from a previous flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Error Notifications ──────────────────────────────────────────────────────
# Email address to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP credentials for sending notification emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your regular password)
SMTP_PASS=your_app_password_here

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Maximum new leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25
