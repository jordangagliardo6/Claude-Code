# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Sheet ID is the long string in the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1EVGUTgiRvTa5FdoGjLBtHf3yvR_mUFpsBpIUFMaDIaM

# Tab name inside the spreadsheet (default: Sheet1 — rename in Google Sheets if needed)
SHEET_TAB_NAME=Sheet1

# Path to your Google service account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# ─── Notifications ────────────────────────────────────────────────────────────
# Email address to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional: Gmail app password for email error alerts
# Generate at: https://myaccount.google.com/apppasswords
# Leave blank to only log errors to console
GMAIL_APP_PASSWORD=
GMAIL_SENDER=jgagliardo98@gmail.com

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Cron expression for 7am — runs in America/New_York timezone automatically
# Default: 7:00am every day. Change "0 7" to "30 8" for 8:30am, etc.
CRON_SCHEDULE=0 7 * * *

# Force the process timezone so 7am means 7am Eastern
TZ=America/New_York
