# Apollo.io API key — get from https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google OAuth2 credentials — download from Google Cloud Console:
# APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON
# Save that file somewhere on disk and put the path here
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Path to store the OAuth2 token after the first auth flow
# This file is auto-created after you run `npm run check` for the first time
GOOGLE_TOKEN_PATH=./google-token.json

# Optional: email address for error notifications (requires a Gmail MCP or SMTP setup)
# Leave blank to only log errors to the console
NOTIFICATION_EMAIL=

# Max leads to pull per scheduled run (default 25)
MAX_LEADS_PER_RUN=25
