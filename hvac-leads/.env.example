# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Your Apollo.io API key (Settings → Integrations → API Keys)
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file (relative or absolute)
# e.g. ./credentials/service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account-key.json

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# The tab/sheet name inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ─── Email Alerts (optional) ──────────────────────────────────────────────────
# If set, errors will be emailed in addition to being logged to the console.
# Uses Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
ALERT_EMAIL=jgagliardo98@gmail.com

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern every day
# node-cron uses system time; ensure your server's TZ is set (see README)
CRON_SCHEDULE=0 7 * * *
TZ=America/New_York
