# Apollo.io API key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet/tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Optional: email address for error notifications (if using Gmail SMTP later)
NOTIFICATION_EMAIL=your_email@gmail.com

# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25
