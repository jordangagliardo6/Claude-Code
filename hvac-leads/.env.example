# Apollo.io API Key
# Get this from: https://developer.apollo.io/keys/
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# This is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account credentials JSON file
# Download from Google Cloud Console → IAM & Admin → Service Accounts
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Optional: notification email (used if you add email alerting later)
ALERT_EMAIL=jgagliardo98@gmail.com
