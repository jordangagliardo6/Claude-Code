# Apollo.io API key — get it from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account JSON credentials file
# See SETUP.md for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Sheet tab name to write leads into (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in Eastern Time (default: 7am ET daily)
# Format: "minute hour * * *"
CRON_SCHEDULE=0 7 * * *
