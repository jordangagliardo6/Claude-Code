# Apollo.io API Key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID (from the sheet URL)
# Current master sheet: https://docs.google.com/spreadsheets/d/1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Sheet tab name (defaults to "Sheet1" or the first tab)
SHEET_TAB_NAME=Untitled

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Notification email for errors (uses Gmail if GMAIL_USER/GMAIL_PASS are set)
# Or leave blank to use console logging only
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Optional: Gmail SMTP credentials for email error alerts
# (create an App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Path to your Google OAuth2 credentials JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path to store the OAuth2 token after first auth (auto-created)
GOOGLE_TOKEN_PATH=./token.json
