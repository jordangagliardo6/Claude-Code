# ─────────────────────────────────────────────
#  Apollo.io API
#  Get your key at: https://developer.apollo.io → API Keys
# ─────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
#  Google Sheets — OAuth2
#  1. Go to https://console.cloud.google.com
#  2. Create a project → Enable "Google Sheets API"
#  3. Credentials → Create OAuth2 Client ID (Desktop App)
#  4. Download the JSON and save it as:
#     hvac-leads/credentials/google-oauth-client.json
#  5. Run:  npm run authorize   (one-time setup)
# ─────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_FILE=./credentials/google-oauth-client.json
GOOGLE_TOKEN_FILE=./credentials/google-token.json

# The Google Sheets spreadsheet ID (from the URL):
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# ─────────────────────────────────────────────
#  Error notification email  (optional)
#  Uses Gmail SMTP — enable App Passwords if you have 2FA:
#  https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
NOTIFY_EMAIL=jgagliardo98@gmail.com
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─────────────────────────────────────────────
#  Lead generation settings (optional overrides)
# ─────────────────────────────────────────────
MAX_LEADS_PER_RUN=25
