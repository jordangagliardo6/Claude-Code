# ── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets Auth (choose ONE of the two options below) ─────────────────

# Option A — Paste the entire service account JSON as a single-line string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Option B — Point to the JSON file on disk:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Email Notifications (optional) ───────────────────────────────────────────
# If set, errors will trigger an email alert in addition to the log file.
# NOTIFY_EMAIL=jgagliardo98@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password   # Use a Gmail App Password, not your login password
