# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet within the spreadsheet (default: Leads)
GOOGLE_SHEETS_TAB_NAME=Leads

# Path to your Google Service Account credentials JSON file.
# See README.md for how to create this file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# ─── Lead Generation Settings ────────────────────────────────────────────────
# Maximum leads to pull per scheduled run (keep low so the list stays manageable)
MAX_LEADS_PER_RUN=25

# ─── Error Notification Email (optional) ─────────────────────────────────────
# If set, errors will be emailed to this address via SMTP.
# Leave blank to disable email alerts (errors will still log to console).
NOTIFY_EMAIL=jgagliardo98@gmail.com

# SMTP settings — only needed if NOTIFY_EMAIL is set.
# Example below uses Gmail App Passwords (requires 2FA enabled on your Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=your_gmail@gmail.com
