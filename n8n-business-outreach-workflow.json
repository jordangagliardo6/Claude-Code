      "id": "a1b2c3d4-0005-0005-0005-a1b2c3d40005",
      "name": "Apify – Fetch Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 400],
      "credentials": {
        "httpQueryAuth": {
          "id": "apify-creds",
          "name": "Apify API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse and clean Apify Google Maps results\nconst rawItems = $input.all();\nconst config = $('Search Config').first().json;\n\nconst cleaned = [];\n\nfor (const item of rawItems) {\n  const d = item.json;\n\n  // Skip entries without a phone number\n  const phone = (d.phone || d.phoneUnformatted || '').replace(/\\D/g, '');\n  if (phone.length < 10) continue;\n\n  // Skip chains / large franchises (many reviews = not a small owner)\n  const reviewCount = d.reviewsCount || d.totalScore || 0;\n  if (reviewCount > 500) continue;\n\n  cleaned.push({\n    businessName: d.title || '',\n    ownerName: '',            // Apify doesn't always return owner — enrichment step\n    phone: phone,\n    formattedPhone: d.phone || '',\n    address: d.address || '',\n    city: config.city,\n    state: config.state,\n    website: d.website || '',\n    rating: d.totalScore || '',\n    reviewCount: d.reviewsCount || 0,\n    category: (d.categories && d.categories[0]) || config.niche,\n    googleMapsUrl: d.url || '',\n    dateAdded: new Date().toISOString().split('T')[0],\n    vmSent: 'No',\n    vmDate: '',\n    status: 'New',\n    notes: ''\n  });\n}\n\nreturn cleaned.map(item => ({ json: item }));\n"
      },
      "id": "a1b2c3d4-0006-0006-0006-a1b2c3d40006",
      "name": "Process & Clean Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 400]
    },
    {
      "parameters": {
        "operation": "readAllRows",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        }
      },
      "id": "a1b2c3d4-0007-0007-0007-a1b2c3d40007",
      "name": "Google Sheets – Read Existing",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1660, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-creds",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate: only keep leads whose phone isn't already in the sheet\nconst existingRows = $('Google Sheets – Read Existing').all();\nconst newLeads = $('Process & Clean Leads').all();\n\nconst existingPhones = new Set(\n  existingRows\n    .map(r => (r.json.phone || '').replace(/\\D/g, ''))\n    .filter(Boolean)\n);\n\nconst uniqueLeads = newLeads.filter(lead => {\n  const phone = (lead.json.phone || '').replace(/\\D/g, '');\n  return phone && !existingPhones.has(phone);\n});\n\nconsole.log(`Found ${newLeads.length} leads, ${uniqueLeads.length} are new.`);\nreturn uniqueLeads;\n"
      },
      "id": "a1b2c3d4-0008-0008-0008-a1b2c3d40008",
      "name": "Filter Duplicates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1900, 400]
    },
