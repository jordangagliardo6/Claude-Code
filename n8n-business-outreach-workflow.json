    },
    {
      "parameters": {
        "jsCode": "// Deduplicate: keep only leads whose phone isn't already in the sheet\n// Input comes from Merge Owner Data (all items)\nconst existingRows = $('Google Sheets – Read Existing').all();\nconst newLeads = $('Merge Owner Data').all();\n\nconst existingPhones = new Set(\n  existingRows\n    .map(r => (r.json.Phone || r.json.phone || '').replace(/\\D/g, ''))\n    .filter(Boolean)\n);\n\nconst uniqueLeads = newLeads.filter(lead => {\n  const phone = (lead.json.phone || '').replace(/\\D/g, '');\n  return phone && !existingPhones.has(phone);\n});\n\nconsole.log(`Enriched leads: ${newLeads.length}, new after dedup: ${uniqueLeads.length}`);\nreturn uniqueLeads;\n"
      },
