      "id": "a1b2c3d4-0012-0012-0012-a1b2c3d40012",
      "name": "Loop Each Lead",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [3340, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "=You are an AI assistant helping prioritize leads for an AI automation agency cold outreach.\n\nLead info:\n- Business: {{ $json['Business Name'] }}\n- Owner Name: {{ $json['Owner Name'] || 'Unknown' }}\n- Category: {{ $json['Category'] }}\n- Rating: {{ $json['Rating'] }} stars ({{ $json['Review Count'] }} reviews)\n- City: {{ $json['City'] }}, {{ $json['State'] }}\n- Website: {{ $json['Website'] }}\n- Phone Type: {{ $json['Phone Type'] }}\n\nPhone type context:\n- \"Owner Mobile\" or \"Owner Direct\" = you are reaching the OWNER personally on their cell\n- \"Owner-Operated (Business #)\" = tiny shop, owner answers their own phone\n- \"Business Line (Screened)\" = receptionist may screen — needs stronger VM\n\nRespond ONLY with valid JSON in this exact format:\n{\n  \"priority\": \"High|Medium|Low\",\n  \"reason\": \"1 sentence\",\n  \"vmHook\": \"12-18 word personalized voicemail opening tailored to their specific business type and size\",\n  \"skipOutreach\": false\n}\n\nPriority rules:\n- High: small local business, few reviews, no/basic website, or owner number found directly\n- Medium: established local, decent presence\n- Low: multiple locations, clearly tech-forward\n- skipOutreach: true ONLY for obvious chains, franchises, or irrelevant categories\n\nFor vmHook, if owner name is known, start with their name. Keep it natural and specific to their trade."
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0013-0013-0013-a1b2c3d40013",
      "name": "AI – Score & Personalize Lead",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [3580, 220],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and merge with lead data\nconst lead = $('Loop Each Lead').first().json;\nconst aiRaw = $input.first().json;\n\nlet aiResult = {};\ntry {\n  const text = aiRaw.content || aiRaw.text || JSON.stringify(aiRaw);\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) aiResult = JSON.parse(match[0]);\n} catch(e) {\n  aiResult = { priority: 'Medium', reason: 'Parse error', vmHook: '', skipOutreach: false };\n}\n\nreturn [{\n  json: {\n    ...lead,\n    aiPriority: aiResult.priority || 'Medium',\n    aiReason: aiResult.reason || '',\n    vmHook: aiResult.vmHook || '',\n    skipOutreach: aiResult.skipOutreach || false\n  }\n}];\n"
      },
