      "id": "a1b2c3d4-0005-0005-0005-a1b2c3d40005",
      "name": "Apify – Fetch Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse and clean Apify Google Maps results\nconst rawItems = $input.all();\nconst config = $('Search Config').first().json;\n\nconst cleaned = [];\n\nfor (const item of rawItems) {\n  const d = item.json;\n\n  // Skip entries without a phone number\n  const phone = (d.phone || d.phoneUnformatted || '').replace(/\\D/g, '');\n  if (phone.length < 10) continue;\n\n  // Skip chains / large franchises (500+ reviews = not a small owner)\n  const reviewCount = d.reviewsCount || 0;\n  if (reviewCount > 500) continue;\n\n  cleaned.push({\n    businessName: d.title || '',\n    ownerName: '',\n    ownerPhone: '',\n    phone: phone,\n    phoneType: '',\n    formattedPhone: d.phone || '',\n    address: d.address || '',\n    city: config.city,\n    state: config.state,\n    website: d.website || '',\n    rating: d.totalScore || '',\n    reviewCount: reviewCount,\n    category: (d.categories && d.categories[0]) || config.niche,\n    googleMapsUrl: d.url || '',\n    dateAdded: new Date().toISOString().split('T')[0],\n    vmSent: 'No',\n    vmDate: '',\n    status: 'New',\n    notes: ''\n  });\n}\n\nreturn cleaned.map(item => ({ json: item }));\n"
      },
      "id": "a1b2c3d4-0006-0006-0006-a1b2c3d40006",
      "name": "Process & Clean Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/people/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $('Search Config').first().json.apolloApiKey }}\",\n  \"q_organization_name\": \"{{ $json.businessName }}\",\n  \"person_titles\": [\"owner\", \"founder\", \"president\", \"ceo\", \"operator\", \"proprietor\", \"managing director\"],\n  \"person_locations\": [\"{{ $json.city }}, {{ $json.state }}\"],\n  \"per_page\": 1\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-0023-0023-0023-a1b2c3d40023",
      "name": "Apollo – Find Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1660, 400]
    },
    {
      "parameters": {
        "jsCode": "// Merge Apollo owner data with the original lead\n// $input.first().json = Apollo API response for this lead\n// $('Process & Clean Leads').item.json = original lead (paired by item index)\n\nconst apolloResponse = $input.first().json;\nconst originalLead = $('Process & Clean Leads').item.json;\n\nlet ownerName = '';\nlet ownerPhone = '';\nlet phoneType = '';\n\n// Parse Apollo response\nconst people = apolloResponse.people || [];\nif (people.length > 0) {\n  const person = people[0];\n  ownerName = person.name || '';\n\n  // Prefer mobile > direct_phone > any other type\n  const phones = person.phone_numbers || [];\n  const mobileNum = phones.find(p => p.type === 'mobile');\n  const directNum = phones.find(p => p.type === 'direct_phone');\n  const anyNum = phones[0];\n\n  const best = mobileNum || directNum || anyNum;\n  if (best) {\n    ownerPhone = (best.sanitized_number || best.raw_number || '').replace(/\\D/g, '');\n    phoneType = mobileNum ? 'Owner Mobile'\n               : directNum ? 'Owner Direct'\n               : 'Apollo Found';\n  }\n}\n\n// Decide final number and label\nlet finalPhone, finalPhoneType;\nif (ownerPhone && ownerPhone.length >= 10) {\n  // Apollo found an owner number — use it\n  finalPhone = ownerPhone;\n  finalPhoneType = phoneType;\n} else if (originalLead.reviewCount <= 30) {\n  // Very small operation — the person answering IS the owner\n  finalPhone = originalLead.phone;\n  finalPhoneType = 'Owner-Operated (Business #)';\n} else {\n  // Larger business, no owner found — business line, likely screened\n  finalPhone = originalLead.phone;\n  finalPhoneType = 'Business Line (Screened)';\n}\n\nreturn [{\n  json: {\n    ...originalLead,\n    ownerName: ownerName,\n    ownerPhone: ownerPhone,\n    phone: finalPhone,\n    phoneType: finalPhoneType\n  }\n}];\n"
      },
      "id": "a1b2c3d4-0024-0024-0024-a1b2c3d40024",
