      "id": "a1b2c3d4-0012-0012-0012-a1b2c3d40012",
      "name": "Loop Each Lead",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2860, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "=You are an AI assistant helping prioritize leads for an AI automation agency cold outreach campaign.\n\nLead info:\n- Business: {{ $json['Business Name'] }}\n- Category: {{ $json['Category'] }}\n- Rating: {{ $json['Rating'] }} stars ({{ $json['Review Count'] }} reviews)\n- City: {{ $json['City'] }}, {{ $json['State'] }}\n- Website: {{ $json['Website'] }}\n\nRespond ONLY with valid JSON in this exact format:\n{\n  \"priority\": \"High|Medium|Low\",\n  \"reason\": \"1 sentence\",\n  \"vmHook\": \"10-15 word personalized hook for voicemail opening based on their business type\",\n  \"skipOutreach\": false\n}\n\nRules:\n- High priority: small local business, few reviews, no website or basic website (likely needs automation)\n- Low priority: franchises, chains, already tech-forward businesses\n- skipOutreach: true only if clearly a chain/franchise or irrelevant"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0013-0013-0013-a1b2c3d40013",
      "name": "AI – Score & Personalize Lead",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [3100, 220],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and merge with lead data\nconst lead = $('Loop Each Lead').first().json;\nconst aiRaw = $input.first().json;\n\nlet aiResult = {};\ntry {\n  // Extract JSON from AI text response\n  const text = aiRaw.content || aiRaw.text || JSON.stringify(aiRaw);\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) aiResult = JSON.parse(match[0]);\n} catch(e) {\n  aiResult = { priority: 'Medium', reason: 'Parse error', vmHook: '', skipOutreach: false };\n}\n\nreturn [{\n  json: {\n    ...lead,\n    aiPriority: aiResult.priority || 'Medium',\n    aiReason: aiResult.reason || '',\n    vmHook: aiResult.vmHook || '',\n    skipOutreach: aiResult.skipOutreach || false\n  }\n}];\n"
      },
      "id": "a1b2c3d4-0014-0014-0014-a1b2c3d40014",
      "name": "Merge AI Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3340, 300]
    },
