    {
      "parameters": {
        "url": "=https://api.apify.com/v2/acts/compass~crawler-google-places/runs/last/dataset/items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $credentials.apifyApiToken }}"
            },
            {
              "name": "limit",
              "value": "={{ $('Search Config').item.json.maxResults }}"
