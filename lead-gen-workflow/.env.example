# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your downloaded service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Spreadsheet ID — found in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Leads

# ─── Workflow settings ────────────────────────────────────────────────────────
# Max new leads to add per scheduled run
MAX_LEADS_PER_RUN=25

# ─── Error alerts (optional) ──────────────────────────────────────────────────
# Email address to notify on failures (requires nodemailer setup in src/index.js)
ALERT_EMAIL=your@email.com

# ─── Timezone ─────────────────────────────────────────────────────────────────
# Keep this set so logs and the cron both treat 7am as Eastern Time
TZ=America/New_York
