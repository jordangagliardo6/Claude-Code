# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The long ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account credentials JSON file.
# See README.md for how to generate this file.
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# ─── Email Alerts (optional) ──────────────────────────────────────────────────
# If left blank, errors are logged to console only (logs/errors.log).
# Uses Gmail with an App Password — see README.md for setup.
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── Workflow Tuning (optional — defaults shown) ──────────────────────────────
# Max leads to pull per run (keep low so the list stays workable)
MAX_LEADS_PER_RUN=25

# Cron schedule (default = 7:00 AM Eastern Time).
# The server must be in US/Eastern TZ, or adjust the hour offset yourself.
# Format: "minute hour * * *"
CRON_SCHEDULE=0 7 * * *
