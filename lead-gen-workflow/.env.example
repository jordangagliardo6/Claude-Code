# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Extract from your sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google service account credentials JSON file
# (relative to the project root)
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Alert email — receives error notifications (optional, requires nodemailer setup)
ALERT_EMAIL=your_email@example.com

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25
