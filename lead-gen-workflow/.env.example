# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets - Spreadsheet ID
# This is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Sheets tab/sheet name (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google Service Account JSON key file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts > Keys
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# Email alert settings (optional — leave blank to use console-only logging)
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=sender@gmail.com
# For Gmail: use an App Password (not your main password)
# https://support.google.com/accounts/answer/185833
ALERT_EMAIL_PASSWORD=your_gmail_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern Time (12:00 UTC)
# Format: minute hour day month weekday
CRON_SCHEDULE=0 12 * * *

# Set to "true" to see full API responses in logs
DEBUG=false
