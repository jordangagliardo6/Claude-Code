# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The long ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside your spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google Service Account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ─── Workflow tuning ─────────────────────────────────────────────────────────
# Maximum leads pulled per scheduled run (keep ≤ 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# ─── Email alerts (optional — leave blank to use console-only logging) ────────
ALERT_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
