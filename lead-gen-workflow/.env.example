# ─────────────────────────────────────────────
# Apollo.io
# Get your key: app.apollo.io → Settings → API
# ─────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# Spreadsheet ID is in the URL:
#   docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# ─────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside your spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your downloaded Google Service Account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# ─────────────────────────────────────────────
# Notifications
# Console alerts are always on. Set this to
# also receive email alerts (requires SMTP setup
# — see README for instructions).
# ─────────────────────────────────────────────
ALERT_EMAIL=your-email@example.com

# ─────────────────────────────────────────────
# Scheduler
# Default: 7:00 AM America/New_York (handles DST)
# Cron format: minute hour day month weekday
# ─────────────────────────────────────────────
CRON_SCHEDULE=0 7 * * *
