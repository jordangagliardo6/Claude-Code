# ──────────────────────────────────────────────────────────────────────────────
# Lead Gen Workflow — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your Apollo.io API key
# Found at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# The long string in your sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# ── Google Auth (choose ONE) ──────────────────────────────────────────────────

# OPTION A — Service Account (recommended for automated/headless runs)
# Path to the downloaded JSON key file from Google Cloud Console.
# Remember to share the spreadsheet with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service_account_key.json

# OPTION B — OAuth2 (if you prefer user-based credentials)
# Run `node setup.js` after placing oauth_credentials.json in credentials/
# and it will guide you through the one-time browser authorization.
# (Leave GOOGLE_SERVICE_ACCOUNT_KEY_FILE blank to use this path)

# ── Scheduler ─────────────────────────────────────────────────────────────────

# Timezone — keeps the 7am trigger pinned to Eastern Time even on a UTC server
TZ=America/New_York

# Cron expression — default is every day at 7:00 AM
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 7 * * *

# Maximum leads to add per scheduled run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# ── Sheet Config ──────────────────────────────────────────────────────────────

# Name of the sheet tab inside the spreadsheet (default: Leads)
SHEET_TAB_NAME=Leads

# ── Email Alerts (optional) ───────────────────────────────────────────────────
# If any of these are blank, errors are logged to console/file only.

# Your email address to receive error alerts
ALERT_EMAIL_TO=you@example.com

# Gmail address to send alerts FROM
ALERT_EMAIL_FROM=yourbot@gmail.com

# Gmail App Password (NOT your regular password)
# Create one at: https://myaccount.google.com/apppasswords
ALERT_EMAIL_PASS=your_app_password_here
