# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Option A (recommended): Path to your service account JSON key file
#   Download from Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Option B: Inline credentials (use if you can't store a file, e.g. cloud deploy)
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Leave blank to skip email alerts — errors will still be logged to console + logs/workflow.log
NOTIFICATION_EMAIL=you@youremail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@youremail.com
SMTP_PASS=your_app_password_here
