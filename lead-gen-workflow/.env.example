# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → Settings → API Keys
# A Basic plan ($49/mo) gives 1,000 people searches/month; free tier = 50.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Error messages are always written to error.log; set this to also get email
# alerts (requires implementing notifyByEmail() in logger.js).
NOTIFY_EMAIL=jgagliardo98@gmail.com
