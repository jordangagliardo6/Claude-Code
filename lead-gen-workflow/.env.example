# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# The exact name of the sheet tab (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account credentials JSON file
# See setup.js for instructions on creating this
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# ─── Email Alerts (optional) ──────────────────────────────────────────────────
# If left blank, errors will only be logged to the console and logs/error.log
ALERT_EMAIL=your_email@example.com

# Gmail SMTP (or use any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Max new leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule (default: 7:00 AM Eastern every day)
# Format: minute hour day month weekday
CRON_SCHEDULE=0 7 * * *

# Timezone for the scheduler
CRON_TIMEZONE=America/New_York
