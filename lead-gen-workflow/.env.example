# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Apollo.io ---
# Settings -> API in your Apollo.io account
APOLLO_API_KEY=

# --- Google OAuth (Sheets/Drive) ---
# Created in Google Cloud Console -> APIs & Services -> Credentials.
# See README.md "Google OAuth setup" for the exact steps to get these three values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# --- Error alert email (optional but recommended) ---
# Any SMTP account works (Gmail App Password, SendGrid, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=jgagliardo98@gmail.com
