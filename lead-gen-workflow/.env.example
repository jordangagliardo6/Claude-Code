# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io/keys/
# Requires a Basic plan or above for People Search
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Option A (recommended): path to the Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account-key.json

# Option B: paste the entire JSON as a single-line string (useful for cloud envs)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# The spreadsheet ID is in the URL: docs.google.com/spreadsheets/d/<ID>/edit
# Pre-filled with your existing SW Michigan HVAC Leads sheet:
GOOGLE_SPREADSHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Name of the sheet tab (the tab label at the bottom)
SHEET_TAB_NAME=Sheet1

# ─── Error notifications ──────────────────────────────────────────────────────
ALERT_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP (use an App Password — not your normal password)
# Enable at: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# Optional — defaults to Gmail if not set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
