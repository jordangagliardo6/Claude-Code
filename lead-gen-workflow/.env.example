# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Find this under your Apollo account → Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The exact name of the tab/sheet inside the spreadsheet (default: Leads)
GOOGLE_SHEET_NAME=Leads

# Path to your downloaded Google service account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Maximum new leads to add per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# ─── Error Alert Email (optional) ────────────────────────────────────────────
# If set, workflow errors will be emailed to this address
ALERT_EMAIL=your_email@example.com

# Gmail account to send alerts from (requires App Password if using Gmail 2FA)
EMAIL_USER=your_sender_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_SERVICE=gmail
