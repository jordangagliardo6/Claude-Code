# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# ── Option A: Service Account (RECOMMENDED for automated/cron use) ───────────
# Path to your service account key JSON file (downloaded from Google Cloud Console)
# Generate one at: https://console.cloud.google.com/iam-admin/serviceaccounts
# After creating, share your spreadsheet with the service account email address.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ── Option B: OAuth2 (if you prefer user-account credentials) ────────────────
# Uncomment and fill in if you're using OAuth2 instead of a service account.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# ─────────────────────────────────────────────────────────────────────────────
# Email notifications (for error alerts)
# ─────────────────────────────────────────────────────────────────────────────
# Gmail address that will SEND the alert (enable "App Passwords" in Google account)
NOTIFY_FROM_EMAIL=your_gmail@gmail.com

# Gmail App Password (not your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_PASSWORD=your_gmail_app_password

# Address that will RECEIVE the alert (can be the same as above)
NOTIFY_TO_EMAIL=jgagliardo98@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Workflow tuning (optional — defaults shown)
# ─────────────────────────────────────────────────────────────────────────────
# Maximum leads to add per scheduled run
MAX_LEADS_PER_RUN=25

# Starting Apollo results page (almost always 1)
APOLLO_START_PAGE=1
