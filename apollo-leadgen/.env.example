# --- Apollo.io ---
# API key from https://app.apollo.io -> Settings -> Integrations -> API
APOLLO_API_KEY=

# --- Google Sheets (Drive) ---
# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=
# Tab name inside the spreadsheet that holds the leads table
GOOGLE_SHEET_TAB=Leads
# Path to the OAuth client file downloaded from Google Cloud Console
GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json
# Path where the generated user token is cached after running `npm run authorize`
GOOGLE_OAUTH_TOKEN_PATH=./token.json

# --- Error alerting (optional but recommended) ---
# If these are set, errors are emailed via Gmail SMTP using an App Password
# (https://myaccount.google.com/apppasswords). If left blank, errors are only
# logged to the console.
ALERT_EMAIL_USER=
ALERT_EMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=jgagliardo98@gmail.com
