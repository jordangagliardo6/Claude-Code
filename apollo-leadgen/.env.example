# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Apollo.io ---
# Get this from Apollo: Settings -> Integrations -> API -> API Keys
APOLLO_API_KEY=

# Optional. Apollo only reveals direct/mobile phone numbers asynchronously via a
# webhook (number verification takes a few seconds to minutes). If you have a
# public endpoint to receive that callback, set it here. If left blank, the
# workflow falls back to whatever phone number Apollo returns directly in the
# search results (usually the company's main line).
APOLLO_PHONE_WEBHOOK_URL=

# --- Google Sheets (OAuth) ---
# Created in Google Cloud Console -> APIs & Services -> Credentials
# (OAuth client ID, type "Desktop app").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated once by running `npm run get-google-token` (see README.md).
GOOGLE_REFRESH_TOKEN=

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Name of the tab/sheet within the spreadsheet to read/write. Defaults to "Leads".
GOOGLE_SHEET_TAB_NAME=Leads

# --- Error alerting (optional) ---
# If set, errors (Apollo failures, Sheets write failures) are emailed here in
# addition to being logged to the console. Requires SMTP_* vars below.
ALERT_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
