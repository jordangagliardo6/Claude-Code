# ============================================================
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- Apollo.io ---
# Get your key at: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# --- Google Sheets ---
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to the service account JSON key you downloaded from Google Cloud Console.
# Keep this file OUT of git (it's a secret credential).
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# Name of the sheet tab inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# --- Email Alerts (optional) ---
# If these are not set, errors are logged to console only.
# SMTP_USER / SMTP_PASS must be a Gmail address + App Password
# (regular Gmail passwords will NOT work — you need an App Password)
# Enable App Passwords: https://myaccount.google.com/apppasswords
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# --- Scheduler ---
# Set to true to run one cycle immediately when the process starts,
# in addition to the normal 7 AM scheduled runs.
RUN_NOW=false
