# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key from https://developer.apollo.io → API Keys
# Basic plan ($49/mo) gives 1,000 enrichments/month — enough for ~40 daily runs
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file.
# See SETUP.md for how to create this — takes about 5 minutes.
GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# ─── Notifications ────────────────────────────────────────────────────────────
# Where to send error alerts
NOTIFY_EMAIL=jgagliardo98@gmail.com

# SMTP settings for email alerts (leave blank to use console-only logging)
# Gmail example: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
