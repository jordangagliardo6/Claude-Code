# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Gen Workflow — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apollo.io ────────────────────────────────────────────────────────────────
# Found in Apollo → Settings → Integrations → API
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google service account JSON key file (relative to project root).
# See setup.js for instructions on creating a service account.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Alternative: paste the entire service account JSON as a single-line string.
# Use this if you prefer not to store a key file on disk.
# If both are set, KEY_PATH takes priority.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Workflow Settings ─────────────────────────────────────────────────────────
# Maximum leads to pull and attempt to add per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# ── Optional: Email Alerts on Error ──────────────────────────────────────────
# If set, workflow errors will be emailed to ALERT_EMAIL.
# Requires nodemailer: npm install nodemailer
# Leave blank to use console-only error logging.
ALERT_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
