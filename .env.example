# ─── Apollo.io ──────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io → API Keys
# Free tier: 50 credits/month | Basic ($49/mo): 1,000/month
# Each people-search page costs 1 credit (up to 25 results)
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Copy the spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: "HVAC Leads")
GOOGLE_SHEET_TAB=HVAC Leads

# Path to your Google service account JSON key file.
# See credentials/README.md for how to create one.
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/service-account.json

# ─── Error notifications (optional) ─────────────────────────────────────────
# If you want email alerts when the script fails, fill these in.
# Use Gmail with an App Password (not your main password).
# Generate an App Password at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=jgagliardo98@gmail.com
NOTIFY_EMAIL_FROM=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_here

# ─── Run config ──────────────────────────────────────────────────────────────
# Max leads to pull per run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern every day
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=America/New_York
