# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at https://app.apollo.io/#/settings/integrations/api
# Required plan: Basic or above (People Search + Phone Enrichment endpoints)
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Path to the credentials.json you download from Google Cloud Console
# See setup.js for step-by-step instructions
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path where setup.js will save the OAuth token (auto-generated)
GOOGLE_TOKEN_PATH=./token.json

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Standard 5-field cron expression. Default = 7:00 AM Eastern every day.
# node-cron handles DST automatically when timezone is set in the script.
# CRON_SCHEDULE=0 7 * * *

# ─── Email Notifications (optional) ──────────────────────────────────────────
# If set, errors are emailed to NOTIFY_EMAIL via this SMTP server.
# For Gmail: use an App Password (not your main password).
# Leave blank to skip email alerts (errors still print to console/logs).
# NOTIFY_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password_here
