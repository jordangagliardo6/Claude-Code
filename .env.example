# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Path to your Google Service Account JSON key file.
# Download from: Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
# Then share your spreadsheet with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# The spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# The name of the sheet tab inside the spreadsheet (bottom tab label)
GOOGLE_SHEET_NAME=Untitled

# ── Email notifications ────────────────────────────────────────────────────────
# Your email address to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail address used to SEND alerts (can be the same as above)
SMTP_USER=jgagliardo98@gmail.com

# Gmail App Password (not your regular password).
# Create at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
SMTP_PASS=your_gmail_app_password_here
