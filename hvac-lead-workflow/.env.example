# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Requires Apollo Basic plan ($49/mo) or higher for People prospecting API.
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────────────────────
# Path to your Google service account JSON file.
# See SETUP.md "Google Credentials" section for how to create one.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json

# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Name of the sheet tab (bottom tab label in Google Sheets). Default: Sheet1
SHEET_NAME=Sheet1

# ── Error Notifications (optional) ─────────────────────────────────────────────
# If set, errors will be emailed via Gmail SMTP.
# Leave blank to use console-only error logging.
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail "App Password" — NOT your regular Gmail password.
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Run Settings ───────────────────────────────────────────────────────────────
# Max leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# Cron schedule (default: 7:00 AM Eastern every day)
# Uses America/New_York timezone — you don't need to convert to UTC.
CRON_SCHEDULE=0 7 * * *
