# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The Sheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab inside your spreadsheet where leads are stored
GOOGLE_SHEET_TAB=Leads

# Path to your Google service account JSON key file
# Download it from Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# ─── Optional: email alert on failure ────────────────────────────────────────
# Set these if you want error emails via Gmail SMTP (optional — console logs always run)
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=your@gmail.com
ALERT_EMAIL_APP_PASSWORD=your_gmail_app_password

# ─── Run config ───────────────────────────────────────────────────────────────
# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule (default: 7am Eastern = 12:00 UTC, accounting for EST/EDT)
# Format: "minute hour * * *"
# 7am EST = 12:00 UTC  |  7am EDT = 11:00 UTC
# This default uses 12:00 UTC (works for EST; change to 11 for EDT/summer)
CRON_SCHEDULE=0 12 * * *
