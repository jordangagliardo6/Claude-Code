# Apollo.io API key
# Get it from: https://developer.apollo.io → API Keys
# Free tier: 50 enrichments/month | Basic ($49/mo): 1,000/month
# NOTE: People Search (phone numbers + owner data) requires a paid Apollo plan.
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Copy from your sheet URL: https://docs.google.com/spreadsheets/d/THIS_ID/edit
# Target sheet: "HVAC Leads — SW Michigan (Master)"
GOOGLE_SHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Google OAuth credentials file path (relative to this directory)
# Generate via Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Download as JSON and save here
GOOGLE_CREDENTIALS_FILE=./credentials.json

# Google OAuth token file (auto-generated on first run)
GOOGLE_TOKEN_FILE=./token.json

# Max leads to pull per run (keeps the sheet manageable)
MAX_LEADS_PER_RUN=25

# Notification email (for error alerts)
NOTIFY_EMAIL=jgagliardo98@gmail.com
