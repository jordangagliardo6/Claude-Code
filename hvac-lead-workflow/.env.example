# Apollo.io API Key
# Find it at: https://app.apollo.io/#/settings/integrations/api
# Requires at least the Apollo Basic plan ($49/mo) for prospecting search
APOLLO_API_KEY=your_apollo_api_key_here

# Google OAuth2 Credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "Google Sheets API"
# 3. Create OAuth2 credentials (Desktop App type)
# 4. Download the JSON and use client_id / client_secret below
# 5. Run `npm run auth` to get your refresh token
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# The spreadsheet to write leads into.
# This is pre-filled with your existing "SW Michigan HVAC Leads" sheet.
SPREADSHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Optional: Email address to notify on errors (requires nodemailer setup — see README)
NOTIFY_EMAIL=jgagliardo98@gmail.com
