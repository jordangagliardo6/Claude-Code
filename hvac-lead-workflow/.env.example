# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────────────────────────────────────
# Your Apollo.io API key — found at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────────────────────────────────────
# Path to your downloaded service account JSON key file
# (see SETUP.md for instructions on creating one)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json

# The ID of your Google Spreadsheet — found in the URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The exact name of the sheet tab to write to (default: Sheet1)
GOOGLE_SHEET_NAME=Leads

# ─────────────────────────────────────────────────────────────────────────────
# Email Notifications (optional — leave blank to use console-only alerts)
# ─────────────────────────────────────────────────────────────────────────────
# Address to receive error notifications
NOTIFICATION_EMAIL=you@example.com

# Gmail "App Password" (not your regular password).
# Enable 2FA on your Google account, then create an app password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ─────────────────────────────────────────────────────────────────────────────
# Workflow settings (optional — safe to leave as defaults)
# ─────────────────────────────────────────────────────────────────────────────
# Max new leads to add per daily run
MAX_LEADS_PER_RUN=25

# Cron schedule (default = 7:00 AM Eastern every day)
# Uses node-cron syntax.  Timezone is always America/New_York.
CRON_SCHEDULE=0 7 * * *
