# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Option A (recommended): paste the full contents of your service-account JSON here
# as a single-line string (e.g. cat credentials.json | tr -d '\n')
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: leave the above blank and place credentials.json in this directory

# ── Error Email Notifications ─────────────────────────────────────────────────
# Your Gmail address used to SEND the notification
SMTP_USER=your_gmail@gmail.com
# A Gmail App Password (NOT your regular password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password

# Where to SEND the notification (defaults to jgagliardo98@gmail.com in code)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
