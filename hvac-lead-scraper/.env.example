# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io → API Keys
# Free tier: 50 enrichments/month | Basic ($49/mo): 1,000/month
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your service account JSON key file (recommended for production).
# If you're using `gcloud auth application-default login` instead, leave this blank.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account-key.json

# Optional: name of the tab inside your sheet. Default is "Sheet1".
# SHEET_TAB_NAME=Sheet1

# ── Error notifications ───────────────────────────────────────────────────────
# Where to send error alerts. Leave blank to only log errors to the console.
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail address and App Password for sending alert emails.
# Create an App Password at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password_here
