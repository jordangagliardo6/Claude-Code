# Apollo.io API key — get from https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Absolute path to your Google service account credentials JSON file
# (see README for how to create a service account)
GOOGLE_CREDENTIALS_PATH=/path/to/service-account-credentials.json

# Error notification email — where to send alerts when the scraper fails
# If using Gmail SMTP you need an App Password (not your regular password):
# https://myaccount.google.com/apppasswords
ALERT_EMAIL_TO=you@email.com
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25
