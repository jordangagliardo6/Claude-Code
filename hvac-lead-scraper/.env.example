# Apollo.io API Key
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Drive Spreadsheet ID
# The part of the URL between /d/ and /edit  e.g. 1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs
SPREADSHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Google OAuth2 credentials (from Google Cloud Console)
# Download credentials.json from your OAuth2 client and paste the values here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# After running `node auth.js` the first time, paste the refresh token here
GOOGLE_REFRESH_TOKEN=your_refresh_token_after_first_auth

# Email alert settings (optional — uses Gmail SMTP with App Password)
ALERT_EMAIL=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
