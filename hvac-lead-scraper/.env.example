# Apollo.io API Key
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google OAuth2 Credentials
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Run `npm run setup` to complete the auth flow and fill in GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_after_setup

# Google Sheets
# Copy from your spreadsheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Optional: Email alerts on error
# Leave blank to disable email notifications (errors will still log to console)
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
