# Apollo.io API key — get it from https://developer.apollo.io/keys/
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long ID in the sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google OAuth credentials file path (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Token file — created automatically on first run after you authorize
GOOGLE_TOKEN_PATH=./token.json

# Optional: email to receive error alerts (uses Gmail API if set)
ALERT_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per scheduled run (keep low to stay manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00am Eastern (adjust if your server is in a different timezone)
# Eastern Standard Time (UTC-5): 12:00 UTC = 7:00am EST
# Eastern Daylight Time (UTC-4): 11:00 UTC = 7:00am EDT
CRON_SCHEDULE=0 12 * * *
