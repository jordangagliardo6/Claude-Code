# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
# Free tier: 50 enrichments/month | Basic ($49/mo): 1,000/month
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Your master sheet:
GOOGLE_SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# The tab name inside the spreadsheet (check the tab at the bottom of the sheet)
SHEET_NAME=Sheet1

# Path to your Google service account JSON credentials file
# See README for how to create this — takes about 5 minutes
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Maximum new leads to add per daily run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ─── Notifications ────────────────────────────────────────────────────────────
# Your email for error alerts (requires SMTP config below, or leave blank for log-only)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional: SMTP settings for email error alerts
# If not set, errors are logged to error.log only
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
