# Apollo.io API Key
# Get yours at: https://developer.apollo.io → API Keys
# Paid plan required for People Search (Basic plan ~$49/mo gives 1,000 enrichments/month)
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Copy from your sheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Google OAuth2 Credentials
# Download from Google Cloud Console → APIs & Services → Credentials
# Create OAuth 2.0 Client ID (Desktop App), then copy the values below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# After running `node auth.js` the first time, paste the refresh token here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Notification email (for error alerts)
ALERT_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25
