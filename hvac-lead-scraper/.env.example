# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Tab name inside the spreadsheet (default: Sheet1)
SHEET_NAME=Leads

# Auth option A – Service Account (recommended for scheduled automation)
# Set this to the path of your service-account.json file.
# Share the spreadsheet with the service account email (Editor access).
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Auth option B – OAuth2 (alternative; run `node setup.js` once to authorize)
# Leave GOOGLE_SERVICE_ACCOUNT_PATH blank and place credentials.json here instead.
# GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json

# ── Error notifications ────────────────────────────────────────────────────────
# Your email – receives alerts when Apollo or Sheets fail
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP settings for error email alerts (optional – logs to console if omitted)
# Gmail example: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
