# ============================================================
# HVAC Lead Scraper - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ------ Apollo.io ------
# Get your key at: https://developer.apollo.io -> API Keys
# NOTE: Phone number reveal requires Apollo's Basic plan ($49/mo) or higher
APOLLO_API_KEY=your_apollo_api_key_here

# ------ Google Sheets ------
# The spreadsheet ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google service account credentials JSON file
# Default if left blank: ./credentials/service-account.json
# GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Name of the sheet tab to write leads to (default: Leads)
# SHEET_NAME=Leads

# ------ Scraper Behavior ------
# Maximum leads to add per scheduled run (default: 25)
# MAX_LEADS_PER_RUN=25

# ------ Error Notifications (optional) ------
# If set, errors will be emailed here in addition to being logged to console.
# Uses Gmail SMTP — set SMTP_PASS to a Gmail App Password (not your login password).
# Create an App Password at: https://myaccount.google.com/apppasswords
# NOTIFICATION_EMAIL=you@example.com
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_char_app_password
