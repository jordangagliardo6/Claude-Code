# ─────────────────────────────────────────────
#  Apollo.io
# ─────────────────────────────────────────────
# Found at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
#  Google Sheets
# ─────────────────────────────────────────────
# The long ID in your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Absolute path to your Google service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account-key.json

# ─────────────────────────────────────────────
#  Email alerts (optional — uses Gmail SMTP)
# ─────────────────────────────────────────────
# If left blank, errors are logged to console only
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=sender@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password

# ─────────────────────────────────────────────
#  Workflow tuning (optional overrides)
# ─────────────────────────────────────────────
# Max new leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in America/New_York timezone (default: 7am daily)
CRON_SCHEDULE=0 7 * * *
