# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Your Apollo.io API key — found at: https://developer.apollo.io/keys/
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Path to your Google service account key JSON file
# See setup instructions below for how to create this
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# The tab name inside your spreadsheet (default: "Leads")
# SHEET_TAB_NAME=Leads

# ── Notifications ───────────────────────────────────────────────────────────────
# Optional: email to notify on errors (requires Gmail API access on the service account)
# Leave blank to only log errors to console
NOTIFICATION_EMAIL=
