# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your Apollo.io API key.
# Find it at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# The ID of your Google Sheet (found in its URL):
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# ─── GOOGLE SERVICE ACCOUNT ───────────────────────────────────────────────────

# Path to your downloaded service account JSON key file.
# Defaults to "credentials.json" in the project root if not set.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials.json

# ─── OPTIONAL SHEET SETTINGS ─────────────────────────────────────────────────

# Name of the tab inside the spreadsheet. Defaults to "Sheet1".
# SHEET_NAME=Sheet1

# Max leads to pull per scheduled run. Defaults to 25.
# MAX_LEADS_PER_RUN=25

# ─── OPTIONAL SCHEDULER OVERRIDES ────────────────────────────────────────────

# Cron expression (default: every day at 7:00 AM).
# CRON_SCHEDULE=0 7 * * *

# IANA timezone for the cron schedule. Defaults to Eastern Time.
# CRON_TIMEZONE=America/New_York

# ─── OPTIONAL EMAIL ALERTS ───────────────────────────────────────────────────
# If all four SMTP vars are set, errors will be emailed in addition to being logged.

# NOTIFICATION_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password_here
