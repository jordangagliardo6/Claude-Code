# ─────────────────────────────────────────────────────
# Apollo.io
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
# ─────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────
# Google Sheets
# The ID is the long string in your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# ─────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Sheet1)
SHEET_NAME=Sheet1

# ─────────────────────────────────────────────────────
# Lead generation settings
# ─────────────────────────────────────────────────────
MAX_LEADS_PER_RUN=25

# Cron schedule (default: 7:00 AM daily — uses America/New_York timezone)
# Format: "minute hour day-of-month month day-of-week"
CRON_SCHEDULE=0 7 * * *

# ─────────────────────────────────────────────────────
# Email error notifications (optional — uses Gmail App Password)
# Leave blank to disable email alerts (errors will still log to console + logs/)
# ─────────────────────────────────────────────────────
NOTIFICATION_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
