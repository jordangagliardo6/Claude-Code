# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Leads

# Path to your Google service account JSON key file
# Create one at: https://console.cloud.google.com → IAM → Service Accounts
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account-key.json

# ─── Email alerts (optional) ──────────────────────────────────────────────────
# If set, error emails are sent via Gmail App Password.
# Leave blank to disable email alerts (errors still print to console).
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=your_gmail@gmail.com
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Workflow tuning (optional) ───────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in UTC — "0 12 * * *" = 7am Eastern Standard (UTC-5)
# During EDT (UTC-4): use "0 11 * * *"
# Tip: adjust seasonally, or just leave at 12 UTC (safe year-round for ≤7am ET)
CRON_SCHEDULE=0 12 * * *
