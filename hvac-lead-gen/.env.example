# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────────────────────
# The ID from your sheet URL: docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1i2wPT9RFCoNTN1_sT2gfJ6yaONTQeudLFg7CAvASFd8

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ── Error Notifications ────────────────────────────────────────────────────────
# Email address that receives error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP settings for sending the alert email
# Gmail example: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jgagliardo98@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Workflow Tuning (optional) ─────────────────────────────────────────────────
# Maximum new leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25
