# Apollo.io API Key
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Found in the spreadsheet URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab to write to (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google OAuth credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path to store the OAuth token after first auth
GOOGLE_TOKEN_PATH=./token.json

# Email notification settings (optional — leave blank to use console-only logging)
NOTIFY_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# Max leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00am Eastern (12:00 UTC)
# Adjust if your server is in a different timezone
CRON_SCHEDULE=0 12 * * *
