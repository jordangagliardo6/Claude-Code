# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to your service account JSON key file (recommended for automated scripts)
# See setup-check.js --help output for instructions on creating a service account.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Alternatively, paste the entire service account JSON as a single-line string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Your Google Spreadsheet ID — copy from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Email to alert when a run fails (optional — see workflow.js to enable SMTP)
NOTIFICATION_EMAIL=your@email.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for the daily run. Default: 7:00 AM Eastern every day.
# The timezone is set to America/New_York automatically in index.js.
CRON_SCHEDULE=0 7 * * *
