# ─── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key: https://app.apollo.io/#/settings/integrations/api
# NOTE: The people-search endpoint requires a PAID Apollo plan (Basic or above).
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ──────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the Google Sheets URL between /d/ and /edit
# e.g. https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# Path to your Google service account credentials JSON file (see setup.md for instructions)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Optional: Email alerts on error ────────────────────────────────────────────
# If left blank, errors are only logged to the console.
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Use a Gmail App Password, not your regular password:
# https://support.google.com/accounts/answer/185833
SMTP_PASS=your_app_password_here
