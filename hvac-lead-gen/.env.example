# ─── Apollo.io ───────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The long ID from the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to the service account JSON you downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ─── Email Alerts (optional — leave blank to use console-only logging) ────────
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
