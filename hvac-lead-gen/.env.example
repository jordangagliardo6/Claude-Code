# Apollo.io API Key
# Get yours at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — ID from the sheet URL
# URL format: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tab name inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# Max leads to pull per scheduled run (keep ≤25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Notification email for errors (used if Gmail credentials are configured)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Path to your Google OAuth2 credentials JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# Path where the OAuth token is cached after first auth
GOOGLE_TOKEN_PATH=./credentials/token.json
