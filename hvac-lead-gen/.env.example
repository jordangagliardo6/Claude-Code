# ────────────────────────────────────────────────────────────
#  HVAC Lead Gen — Environment Variables
#  Copy this file to .env and fill in your real values.
#  Never commit .env to git.
# ────────────────────────────────────────────────────────────

# ── Apollo.io ────────────────────────────────────────────────
# Get your key: https://developer.apollo.io → API Keys
# NOTE: Phone numbers require a Basic plan ($49/mo) or higher.
#       The free tier searches work but return 0 phones.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ────────────────────────────────────────────
# The Spreadsheet ID is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
#
# Your "SW Michigan HVAC Leads" sheet is already pre-filled below.
SPREADSHEET_ID=1j1ooSkFSEc4G7vPv2T6XMGxgifaLcldfxNVm2231UYY

# The tab name inside the spreadsheet (bottom tab bar label).
# Default is Sheet1; change this if your tab is named differently.
SHEET_TAB=Sheet1

# ── Scheduling ───────────────────────────────────────────────
# Runs in America/New_York timezone.
# Default: 7:00 AM Eastern every day.
# Cron syntax:  minute  hour  day  month  weekday
CRON_SCHEDULE=0 7 * * *

# ── Error Email Notifications (optional) ─────────────────────
# If SMTP is configured, workflow errors are emailed to NOTIFY_EMAIL.
# Leave blank to skip email alerts (errors still log to console).
#
# Gmail example: use an App Password, not your regular password.
#   https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
