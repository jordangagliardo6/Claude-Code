# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Option A (recommended): Service Account JSON key file
#   1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Create a service account, download the JSON key
#   3. Share your spreadsheet with the service account email (editor access)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# Option B: Inline base64-encoded service account JSON (useful for CI/cloud)
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=<base64-encoded contents of the JSON key>

# The spreadsheet ID from your Google Drive URL
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1IGu3eIM6shnjmlTpD0K65Fud_4XPvIb1RRclpAgl_NU

# The exact name of the sheet tab inside the spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ─── Email Notifications ─────────────────────────────────────────────────────
# Gmail: enable "App Passwords" at myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=jgagliardo98@gmail.com
NOTIFY_EMAIL_FROM=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jgagliardo98@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Max leads to pull per run (keep manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00 AM Eastern every day
# node-cron uses server local time; see TZ variable below to override
CRON_SCHEDULE=0 7 * * *
TZ=America/New_York
