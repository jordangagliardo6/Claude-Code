# ─── Apollo.io ─────────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ──────────────────────────────────────────────────────────────
# Path to the service account JSON key file (see SETUP.md for how to create it)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# The spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab to write to (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# ─── Email Alerts (optional) ────────────────────────────────────────────────────
# If set, errors will be emailed in addition to being logged to console.
# Leave blank to disable email alerts.
ALERT_EMAIL_TO=jgagliardo98@gmail.com

# SMTP credentials for sending alerts (Gmail example shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
