# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets / Drive ────────────────────────────────────────────────────
# Step 1: Go to https://console.cloud.google.com
# Step 2: Create a project → enable "Google Sheets API" + "Google Drive API"
# Step 3: Create OAuth 2.0 Client ID credentials (Desktop App type)
# Step 4: Download the credentials JSON and save it as google-credentials.json
#         in the same folder as this file
# Step 5: On first run the script opens a browser for OAuth consent — paste the
#         auth code back into the terminal. A token.json is saved so you only
#         do this once.
GOOGLE_CREDENTIALS_FILE=google-credentials.json
GOOGLE_TOKEN_FILE=token.json

# The spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Leads)
GOOGLE_SHEET_TAB=Leads

# ─── Email Alerts (optional — uses Gmail SMTP) ────────────────────────────────
# If you want error emails, fill these in. Leave blank to skip email alerts.
# For Gmail: use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00 AM Eastern Time daily
# Eastern Time is UTC-5 (EST) or UTC-4 (EDT). Using America/New_York timezone.
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=America/New_York
