# ─────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────
# Get your key at: https://developer.apollo.io/
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# ─────────────────────────────────────────────
# Workflow settings
# ─────────────────────────────────────────────
# Max new leads to add per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────
# Error notifications (optional — leave blank to use console-only)
# ─────────────────────────────────────────────
# Email address to receive error alerts
NOTIFY_EMAIL=your@email.com

# SMTP settings (example uses Gmail; adjust for your provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
