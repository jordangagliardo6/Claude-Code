# ─────────────────────────────────────────────────────────────
# Apollo.io — get your key at https://developer.apollo.io
# ─────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────
# Google Sheets
#   Option A (recommended for automation): Service Account
#     1. Go to console.cloud.google.com → Create project
#     2. Enable "Google Sheets API"
#     3. Create a Service Account → download the JSON key
#     4. Place the JSON key file in ./credentials/
#     5. Set GOOGLE_SERVICE_ACCOUNT_KEY_FILE to the full path
#     6. Share your Google Sheet with the service account email
#
#   Option B: OAuth2 (requires browser flow on first run)
#     Leave SERVICE_ACCOUNT blank and fill in OAUTH fields.
# ─────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Your Google Spreadsheet ID
# Copy from the URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the worksheet tab (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# ─────────────────────────────────────────────────────────────
# Optional: Email alerts on errors
#   Leave blank to disable email alerts (errors still log to console)
# ─────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=your_email@gmail.com
ALERT_EMAIL_FROM=alerts@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password_or_app_password

# ─────────────────────────────────────────────────────────────
# Tuning (optional — defaults are sensible)
# ─────────────────────────────────────────────────────────────
MAX_LEADS_PER_RUN=25
