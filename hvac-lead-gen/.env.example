# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet was already created for you at:
# https://docs.google.com/spreadsheets/d/19mDLT7Jy-mLSn78KRh3sdCT20yyiWimQUUWCw--GEoM/edit
GOOGLE_SPREADSHEET_ID=19mDLT7Jy-mLSn78KRh3sdCT20yyiWimQUUWCw--GEoM

# ─── Google Service Account credentials (choose ONE option) ───────────────────
# Option A – path to the JSON key file you downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Option B – paste the entire JSON inline (useful for cloud/CI environments)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Email alerts (optional) ──────────────────────────────────────────────────
# If these are set, workflow failures send an email. Otherwise errors are
# logged to console + logs/hvac-lead-gen.log only.
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
# For Gmail use an App Password (not your main password):
# https://support.google.com/accounts/answer/185833
SMTP_PASS=your_gmail_app_password

# ─── Scheduler (optional overrides) ──────────────────────────────────────────
# Default: 7:00 AM Eastern Time daily. Uses IANA timezone America/New_York.
# CRON_SCHEDULE=0 7 * * *
