# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
# NOTE: People search requires a PAID plan (Basic = $49/mo or higher).
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# Your current "SW Michigan HVAC Leads" sheet ID is pre-filled below.
GOOGLE_SHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Service account credentials from Google Cloud Console.
# See SETUP.md → Step 3 for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Error Notifications (optional) ──────────────────────────────────────────
# If set, error messages will be logged with this address shown.
# Wire up Nodemailer in index.js handleError() to actually send email.
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
