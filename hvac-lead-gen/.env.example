# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab to write to (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google Service Account JSON key file
# See setup.js for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account-key.json

# ─── Email Notifications (optional — leave blank to disable) ─────────────────
# SMTP credentials for error alerts (uses Gmail by default)
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=your_gmail@gmail.com
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─── Lead Config ─────────────────────────────────────────────────────────────
# Max leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00am Eastern (12:00 UTC)
# Format: "minute hour * * *"
CRON_SCHEDULE=0 12 * * *
