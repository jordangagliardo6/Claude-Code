# ════════════════════════════════════════════════════════════
#  HVAC Lead Gen Workflow — Environment Variables
#  Copy this file to ".env" and fill in your values.
#  Never commit the real .env file to version control.
# ════════════════════════════════════════════════════════════

# ── Apollo.io ─────────────────────────────────────────────
# Find this at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google service-account JSON key file.
# Alternatively, place the file at credentials/google-service-account.json
# and leave this variable commented out.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json

# ── Workflow settings ──────────────────────────────────────
# Max leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in node-cron format (default: 7:00 AM Eastern daily)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 7 * * *

# ── Email alerts (optional) ────────────────────────────────
# If these are set, error alerts and daily summaries are emailed.
# If left blank, errors are logged to the console and logs/ folder only.
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Use an App Password if you have 2FA: https://myaccount.google.com/apppasswords
NOTIFICATION_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_gmail@gmail.com
