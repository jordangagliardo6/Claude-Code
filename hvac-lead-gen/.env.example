# ─────────────────────────────────────────────
# HVAC Lead Generator — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
# Requires at least a Basic plan ($49/mo) for phone number reveals
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────
# The ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Path to your Google credentials JSON (service account or OAuth2)
# Default: ./credentials/service-account.json
# For OAuth2 users: ./credentials/credentials.json
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Name of the sheet tab (default: Leads)
SHEET_TAB_NAME=Leads

# ── Workflow Settings ──────────────────────────
# Maximum leads to add per run (keep manageable — 25 recommended)
MAX_LEADS_PER_RUN=25

# ── Error Notifications (optional) ────────────
# If all three are set, you'll get email alerts on failures
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
