# Apollo.io API Key
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Spreadsheet ID (copy from the URL)
# Example URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Google Sheets tab name (the tab at the bottom of your spreadsheet)
SHEET_TAB_NAME=Untitled

# Google Service Account credentials as a single-line JSON string
# See SETUP.md → Step 3 for how to create and download this
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Maximum leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25

# Optional: notification email for errors (requires SMTP config below)
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Optional SMTP settings for email error alerts (leave blank to skip email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
