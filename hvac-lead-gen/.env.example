# ─────────────────────────────────────────────
# HVAC Lead Generator — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Apollo.io API key (Settings → Integrations → API Keys)
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Set to true to use Apollo enrichment credits to reveal masked phone numbers.
# WARNING: Each enrichment uses 1 Apollo export credit. Only enable if your plan supports it.
REVEAL_PHONE_NUMBERS=false

# ── Error Notification Email (optional) ──────
# If set, errors will be emailed to NOTIFY_EMAIL via Gmail SMTP.
# SMTP_PASS should be a Gmail App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=jgagliardo98@gmail.com
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
