# ── Apollo.io ──────────────────────────────────────────────────────────────
# Get your key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=1vC18Ek-QYf4AdtK21X1VN9cUYnPJgV_5ALPy2M-zg7c

# Service account credentials — choose ONE of the two options below:

# Option A: Path to downloaded JSON key file (recommended for local use)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Option B: Paste the entire JSON content on one line (useful for servers/CI)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Error alert email ──────────────────────────────────────────────────────
# Where to send failure notifications
ALERT_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP credentials for sending error alerts (uses App Password)
# Generate an App Password at: https://myaccount.google.com/apppasswords
# Leave blank to disable email alerts (errors will still appear in console logs)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
