# ── Apollo.io ────────────────────────────────────────────────
# Get this from https://app.apollo.io/#/settings/integrations/api
# Note: People search + phone enrichment requires a paid Apollo plan.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────
# Option A: Service Account (recommended for scheduled jobs)
#   1. Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
#   2. Download the JSON key file
#   3. Enable Google Sheets API at https://console.cloud.google.com/apis/library/sheets.googleapis.com
#   4. Share your lead spreadsheet with the service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account-key.json

# The spreadsheet ID from the sheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# The sheet tab name (default: Sheet1)
SHEET_NAME=Sheet1

# ── Notification email (for error alerts) ────────────────────
# Requires a separate email setup (e.g. nodemailer + Gmail app password)
# Leave blank to disable email alerts and rely on console logs only.
ALERT_EMAIL=jgagliardo98@gmail.com

# ── Workflow config ───────────────────────────────────────────
# Max leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# Set to "true" to trigger an immediate run on process start (for testing)
TEST_RUN=false
