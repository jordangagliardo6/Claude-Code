# ─────────────────────────────────────────────
#  HVAC Lead Gen – Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Apollo.io API Key
# Get it at: https://developer.apollo.io → API Keys → Create API Key
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets – Spreadsheet ID
# Copy from your sheet URL:  .../spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Sheets – Tab name (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google service account JSON key file
# (generated in Google Cloud Console – see setup-test.js for instructions)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# ── Error Notifications ──────────────────────
# Set NOTIFY_EMAIL=true to receive email alerts on failures
NOTIFY_EMAIL=false

# Gmail SMTP (App Password required – not your regular password)
# Enable at: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# Where error alerts should be sent
ALERT_EMAIL=jgagliardo98@gmail.com

# ── Optional Tuning ──────────────────────────
# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25
