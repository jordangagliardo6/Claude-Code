# Apollo.io API key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Absolute path to your Google service account JSON credentials file
# See SETUP instructions in README for how to create this file
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# The Google Sheets spreadsheet ID (from the URL: .../spreadsheets/d/SPREADSHEET_ID/edit)
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Sheet tab name (bottom tab in the spreadsheet)
SHEET_NAME=Untitled

# Max leads to pull per run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Email address to send error alerts to
ALERT_EMAIL=jgagliardo98@gmail.com

# Gmail App Password for sending error alerts
# Generate at: https://myaccount.google.com/apppasswords
# Leave blank to disable email alerts (errors will only be logged to console)
ALERT_EMAIL_PASSWORD=
ALERT_FROM_EMAIL=jgagliardo98@gmail.com
