# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apify ─────────────────────────────────────────────────────────────────────
# Get your token at: apify.com → Settings → Integrations
# Free tier ($5/month credit) is plenty for daily runs.
APIFY_API_TOKEN=your_apify_api_token_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to your service account JSON key file (recommended for automated scripts)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Alternatively paste the entire service account JSON as a single-line string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Your Google Spreadsheet ID — from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_ID/edit
GOOGLE_SPREADSHEET_ID=1SfN3D_lUYp1hGE7CtjTlYlMRnT4DZyXHBgjRcF-xqwg

# ── Notifications ─────────────────────────────────────────────────────────────
# Email to alert when a run fails (optional — see workflow.js to enable SMTP)
NOTIFICATION_EMAIL=your@email.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression. Default: 7:00 AM Eastern every day.
CRON_SCHEDULE=0 7 * * *
