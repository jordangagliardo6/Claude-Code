# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Set to "true" to attempt enrichment for contacts that have no phone in search
# results. Uses Apollo API credits — leave false if you're on a free plan.
APOLLO_ENRICH_CONTACTS=false

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tab name inside the spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# Service account credentials — choose ONE method:
#
#   Method A — file path (recommended for local use):
#     GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
#
#   Method B — entire JSON on one line (good for servers/env vars):
#     GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
#
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Cron expression — defaults to 7:00 AM Eastern every day
# node-cron runs this in America/New_York timezone automatically
CRON_SCHEDULE=0 7 * * *

# Max new leads to add per run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ─── Error Notifications (optional) ─────────────────────────────────────────
# If set, errors are emailed to this address in addition to being logged locally
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail "App Password" for sending error alerts (NOT your Gmail login password).
# Generate one at: https://myaccount.google.com/apppasswords
# Leave blank to disable email notifications (errors still log to errors.log).
GMAIL_APP_PASSWORD=
GMAIL_FROM=jgagliardo98@gmail.com
