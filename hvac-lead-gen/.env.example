# Apollo.io API key — get it at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long string in the sheet's URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the specific tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account JSON credentials file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Optional: email address for error notifications (uses Gmail nodemailer)
# Leave blank to disable email alerts (errors still appear in console)
NOTIFY_EMAIL=your_email@example.com

# Optional: Gmail credentials for sending error alerts
# If using Gmail, enable "App Passwords" in your Google account security settings
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00 AM Eastern Time (12:00 UTC)
# Uses node-cron syntax: https://github.com/node-cron/node-cron
CRON_SCHEDULE=0 12 * * *
