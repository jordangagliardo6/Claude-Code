# ─────────────────────────────────────────────
#  Apollo.io
# ─────────────────────────────────────────────
# Get your key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
#  Google Sheets
# ─────────────────────────────────────────────
# The ID from your sheet's URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your service account JSON key file (relative to hvac-lead-gen/)
# OR leave as "credentials.json" and place the file there
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials.json

# ─────────────────────────────────────────────
#  Email Notifications (optional)
# ─────────────────────────────────────────────
# Set these to receive an email if the workflow errors.
# Uses Gmail App Password — see README for setup steps.
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
