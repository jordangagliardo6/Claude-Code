# ── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key from: https://developer.apollo.io → API Keys
# NOTE: The people search endpoint used here requires a PAID Apollo plan.
# Free plan holders: upgrade at https://www.apollo.io/pricing
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Copy the Sheet ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# Service account JSON file path (RECOMMENDED for automation)
# See SETUP.md → "Google Service Account" for how to create this.
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# OAuth2 alternative (if not using service account)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ── Error Notifications ───────────────────────────────────────────────────────
# Email to notify when a run fails or returns no results.
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP credentials for sending error alerts (optional).
# Use an App Password, not your main Gmail password:
# https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
