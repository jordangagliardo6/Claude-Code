# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get your key at https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Path to your downloaded service-account JSON file (see setup guide below)
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# The spreadsheet to append leads into (pre-filled with your existing sheet)
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ── Notifications ──────────────────────────────────────────────────────────────
# Email address that error alerts are sent TO
ALERT_EMAIL=jgagliardo98@gmail.com

# Gmail address used to SEND alerts (must be the same Gmail account)
GMAIL_USER=jgagliardo98@gmail.com

# Gmail App Password (not your regular password).
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be ON)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── Workflow settings ──────────────────────────────────────────────────────────
# Max new leads to pull per run (keep ≤ 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern Time (UTC-5 / UTC-4 DST)
# node-cron uses server-local time; adjust if your server is in a different TZ.
# Set TZ=America/New_York in your environment to lock it to Eastern.
CRON_SCHEDULE=0 7 * * *
