# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account credentials JSON file
# (default: ./credentials.json — place the file in the project root)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Email Alerts (optional) ───────────────────────────────────────────────────
# If these are set, errors will also be emailed to ALERT_EMAIL in config.js.
# Gmail example: use an App Password, not your regular Gmail password.
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
