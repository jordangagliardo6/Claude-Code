# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# From the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Service account credentials — set these OR place credentials.json in this folder
# (credentials.json is recommended; it takes priority over these env vars)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Email Alerts (optional but recommended) ──────────────────────────────────
# If the job fails, an alert email will be sent to ALERT_EMAIL.
# Uses Gmail by default. For Gmail, use a 16-char App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
