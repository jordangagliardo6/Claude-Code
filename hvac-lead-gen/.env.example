# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# The spreadsheet ID — found in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# The exact name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ─── Email Alerts (optional) ─────────────────────────────────────────────────
# If set, errors will be emailed. Leave blank to use console-only logging.
ALERT_EMAIL_TO=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your main password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password_here

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25
