# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Find your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# Sheet tab name (the tab at the bottom of the spreadsheet)
SHEET_NAME=Untitled

# Path to your Google service account JSON key file.
# See SETUP.md for instructions on creating one.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# ─── Notification email (for error alerts) ───────────────────────────────────
ALERT_EMAIL=jgagliardo98@gmail.com

# ─── Run settings ─────────────────────────────────────────────────────────────
# Max leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# Cron schedule: "0 12 * * *" = 7am Eastern (UTC-5) or 11am EDT (UTC-4).
# The script auto-adjusts for DST. Change only if you want a different time.
CRON_SCHEDULE=0 12 * * *
