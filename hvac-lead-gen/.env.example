# ════════════════════════════════════════════════
#  HVAC Lead Gen — Environment Variables
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════

# ── Apollo.io ────────────────────────────────────
# Find this at: Apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ────────────────────────────────
# Copy the spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet where leads will be appended (default: Leads)
GOOGLE_SHEET_NAME=Leads

# Path to the service account JSON credentials file you downloaded
# from Google Cloud Console (keep this file OUT of version control)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Scheduler ────────────────────────────────────
# Cron expression (default: 7:00 AM every day)
# Format: minute hour day-of-month month day-of-week
CRON_EXPRESSION=0 7 * * *

# Maximum number of new leads to pull per scheduled run
MAX_LEADS_PER_RUN=25

# ── Email Alerts (optional) ───────────────────────
# Set to true to receive email notifications when a run fails
EMAIL_NOTIFICATIONS=false

# Your email address to receive alerts
ALERT_EMAIL=your_email@example.com

# Gmail SMTP (use an App Password, not your regular password)
# Generate an App Password at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
