# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets - ID from your spreadsheet URL
# URL format: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google OAuth credentials (download from Google Cloud Console as JSON)
# Path to your credentials file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Optional: Email alert on errors
# Uses Gmail SMTP — use an App Password if 2FA is enabled
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=your@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7am Eastern (12:00 UTC)
# Adjust if your server runs in a different timezone
CRON_SCHEDULE=0 12 * * *
