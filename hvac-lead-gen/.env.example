# ─────────────────────────────────────────────────────────────────
# Apollo.io — get your key at: https://app.apollo.io/#/settings/integrations/api
# ─────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────
# Google Sheets
#   GOOGLE_SPREADSHEET_ID: the long ID in your sheet URL
#   e.g. https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
#                                                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#   GOOGLE_CREDENTIALS_PATH: path to your service account JSON file
#   GOOGLE_SHEET_NAME: the tab name (default: Leads)
# ─────────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_NAME=Leads

# ─────────────────────────────────────────────────────────────────
# Scheduler — cron expression in America/New_York timezone
# Default: 7:00 AM Eastern every day
# ─────────────────────────────────────────────────────────────────
CRON_SCHEDULE=0 7 * * *

# Max new leads to pull per run (keep manageable)
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────────────────────────
# Optional: Email alerts on workflow errors
#   Uses Gmail App Passwords or any SMTP relay
# ─────────────────────────────────────────────────────────────────
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
