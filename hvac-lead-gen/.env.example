# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Copy the ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab name inside your spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ─── Email Notifications ──────────────────────────────────────────────────────
# Your email — where error alerts are sent
NOTIFICATION_EMAIL=you@example.com

# Gmail address used to SEND the alert (can be same as above)
SMTP_USER=your.gmail@gmail.com

# Gmail App Password (NOT your regular password).
# Enable at: https://myaccount.google.com/security → 2-Step Verification → App passwords
SMTP_PASS=your_gmail_app_password_here
