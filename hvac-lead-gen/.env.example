# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google service account credentials JSON file
# See credentials/README.md for setup instructions
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# ─── Email Notifications (optional but recommended) ───────────────────────────
# Set these to receive email alerts when the workflow errors
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP — use an App Password (not your real password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern every day
# Format: minute hour * * *
CRON_SCHEDULE=0 7 * * *
TIMEZONE=America/New_York
