# ──────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
# Note: People search requires a paid plan (Basic or above).
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────
# Your existing "SW Michigan HVAC Leads" spreadsheet ID is pre-filled in index.js.
# Override here only if you want to point to a different sheet.
SPREADSHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google Service Account credentials JSON file.
# See SETUP.md for how to create one.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Alternative: paste the entire service account JSON as a single-line string.
# Useful for cloud deployments where you can't upload files.
# If set, GOOGLE_CREDENTIALS_PATH is ignored.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Workflow settings ──────────────────────────────────────
# Max new leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25

# Your email for error notifications (logged to console by default)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# ── Optional: SMTP for email error alerts ─────────────────
# Uncomment the nodemailer block in index.js and set these to enable email alerts.
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_gmail_app_password
