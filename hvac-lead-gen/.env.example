# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# (Optional) Sheet tab name — defaults to "Sheet1" if not set
GOOGLE_SHEET_TAB_NAME=Leads

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Set NOTIFY_EMAIL=true to receive error alerts by email
NOTIFY_EMAIL=false

# Your Gmail address (used as sender AND recipient for alerts)
ALERT_EMAIL=you@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2FA to be enabled on your Google account)
GMAIL_APP_PASSWORD=your_gmail_app_password_here
