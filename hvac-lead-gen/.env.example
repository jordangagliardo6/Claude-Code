# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Absolute path to your Google Service Account JSON key file
# See README.md for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/your/service-account-key.json

# ─── Notifications ───────────────────────────────────────────────────────────
# Email address to receive error alerts
NOTIFICATION_EMAIL=your@email.com

# SMTP credentials for sending alert emails (Gmail example shown)
# Leave blank to disable email alerts and use console-only logging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# ─── Optional tuning ─────────────────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in UTC — "0 11 * * *" = 7am Eastern (UTC-4 summer / UTC-5 winter)
# Adjust to "0 12 * * *" in winter (EST) if needed
CRON_SCHEDULE=0 11 * * *
