# Apollo.io API Key
# Get it from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets ID
# Pull this from your sheet URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tab/sheet name inside your spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# Notification email (used for error alerts — must be a Gmail address tied to your Google credentials)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Path to your Google OAuth credentials JSON file (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path where the OAuth token will be stored after first auth
GOOGLE_TOKEN_PATH=./token.json
