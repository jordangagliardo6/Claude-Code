# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/PASTE_THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Error Notifications (optional) ──────────────────────────────────────────
# If all three are set, failed runs send an email alert.
# SMTP_PASS must be a Gmail App Password (not your account password).
# Create one at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=jgagliardo98@gmail.com
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password_here
