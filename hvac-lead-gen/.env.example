# ─────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in the values below.
# NEVER commit your .env or credentials/ to Git.
# ─────────────────────────────────────────────────────────────

# Apollo.io API Key
# Get it from: https://developer.apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Path to your Google Service Account JSON key file
# See "First Run" section in the README for how to generate this file.
# Default: ./credentials/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# Google Spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Tab name inside the spreadsheet to write leads to (default: Leads)
GOOGLE_SHEET_NAME=Leads

# Maximum new leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25
