# Apollo.io API key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long string in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Leads

# Path to your Google service account JSON key file
# See SETUP.md for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Optional: email address for error notifications (future email integration)
ALERT_EMAIL=you@example.com

# Optional: override max leads per run (default: 25)
MAX_LEADS_PER_RUN=25
