# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Generator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Your spreadsheet ID — found in the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your service account JSON key file (relative to hvac-lead-gen/)
# Default: ./credentials.json
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Alternative: paste the raw service account JSON here (for server deployments)
# Leave blank if you are using GOOGLE_CREDENTIALS_PATH instead
# GOOGLE_CREDENTIALS_JSON=

# ── Email Alerts (optional) ───────────────────────────────────────────────────
# Leave blank to disable email — errors will still appear in the console.
# For Gmail, use an App Password (not your regular password):
#   https://myaccount.google.com/apppasswords
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
