# Apollo.io API Key
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Extract from your sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google OAuth credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path to store the OAuth token after first auth (auto-created)
GOOGLE_TOKEN_PATH=./token.json

# Email alert settings (optional — leave blank to disable email alerts)
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=your_gmail@gmail.com
ALERT_EMAIL_APP_PASSWORD=your_gmail_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in America/New_York timezone (default: 7:00 AM Eastern)
CRON_SCHEDULE=0 7 * * *
