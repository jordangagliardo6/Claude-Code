# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Drive Spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Drive OAuth Credentials
# Download from Google Cloud Console > APIs & Services > Credentials
# Save the file as credentials.json in the project root
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Optional: Email alerts on error
# Leave blank to use console-only logging
ALERT_EMAIL=jgagliardo98@gmail.com

# Optional: Gmail credentials for sending error alerts
# Only needed if you want email notifications
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Timezone for scheduler (default: America/New_York)
TIMEZONE=America/New_York

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25
