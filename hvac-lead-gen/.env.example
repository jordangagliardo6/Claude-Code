# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Your Apollo API key. Get it from: https://developer.apollo.io → API Keys
# Free plan: 50 export credits/month | Basic ($49/mo): 1,000/month
# Phone reveal costs 1 credit per successful reveal.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ── Error Notifications ────────────────────────────────────────────────────────
# Where to send error alerts (can be the same as SMTP_USER or different).
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional Gmail SMTP for email alerts.
# If you leave SMTP_USER blank, errors are logged to the console only.
#
# To enable email alerts:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create an App Password for "Mail"
#   3. Paste it below (NOT your regular Gmail password)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
