# Apollo.io API Key
# Get yours at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Configuration
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# Leave blank and the script will create a new sheet on first run.
GOOGLE_SHEET_ID=

# Path to your Google service account JSON credentials file
# See setup.js (run: npm run setup) for instructions on creating this
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Notification email — receives alerts when runs fail or Apollo returns no results
# Leave blank to disable email notifications (errors will still log to console)
NOTIFICATION_EMAIL=your_email@example.com

# SMTP settings for error notification emails
# Gmail example: use an App Password (not your login password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here

# Optional: Override max leads per run (default: 25)
MAX_LEADS_PER_RUN=25
