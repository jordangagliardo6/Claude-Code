# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
# ─────────────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets — OPTION A: Service Account (recommended for server/cron use)
#
# 1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
# 2. Create a service account, download the JSON key
# 3. Share your Google Sheet with the service account email (Editor access)
# 4. Paste the ENTIRE key file content as a single line below
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets — OPTION B: OAuth2 (use if you prefer browser-based auth)
# Leave commented out if using Option A above
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# ─────────────────────────────────────────────────────────────────────────────
# The spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab name inside the spreadsheet (default: Leads)
GOOGLE_SHEET_NAME=Leads

# ─────────────────────────────────────────────────────────────────────────────
# Error notification email
# ─────────────────────────────────────────────────────────────────────────────
ALERT_EMAIL=jgagliardo98@gmail.com
