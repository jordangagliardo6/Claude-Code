# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ── Apollo.io ────────────────────────────────────────────────────────────────
# Your Apollo.io API key.
# Find it at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here


# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID — found in the sheet's URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The name of the tab (sheet) inside the workbook where leads will be written.
# Default: Leads  (create a tab with exactly this name in your spreadsheet)
GOOGLE_SHEET_NAME=Leads


# ── Google Authentication — choose ONE option ─────────────────────────────────
#
# OPTION A: Service Account (RECOMMENDED for automated/server use)
# ---------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → enable "Google Sheets API"
# 3. IAM & Admin → Service Accounts → Create Service Account
# 4. Download the JSON key file, save it next to this .env file
# 5. Share your Google Sheet with the service account email (Editor role)
# 6. Set the path below:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
#
# OPTION B: OAuth2 (use if you prefer browser-based auth)
# ---------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → enable "Google Sheets API"
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
# 4. Download the JSON, then run the OAuth flow to get a refresh token
#    (see SETUP.md for step-by-step instructions)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token


# ── Scheduler ────────────────────────────────────────────────────────────────
# Timezone for the cron schedule. Keep this as America/New_York for 7 AM ET.
TZ=America/New_York

# Cron expression for when to run. Default: every day at 7:00 AM.
# Format: minute hour day-of-month month day-of-week
# Examples:
#   "0 7 * * *"    → 7:00 AM daily
#   "0 8 * * *"    → 8:00 AM daily
#   "0 7 * * 1-5"  → 7:00 AM Monday–Friday only
CRON_SCHEDULE=0 7 * * *

# Maximum leads to pull per run (keeps the list manageable)
MAX_LEADS_PER_RUN=25


# ── Error Alerts (optional) ───────────────────────────────────────────────────
# If set, error alerts are emailed here in addition to being logged.
# Leave blank to use console-only logging.
ALERT_EMAIL=your_email@example.com

# SMTP settings for sending alert emails (Gmail shown as example)
# Gmail: use an App Password, not your main password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here


# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to "true" to enable verbose debug logging
# DEBUG=true
