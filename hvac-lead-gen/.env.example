# ─────────────────────────────────────────────
#  Apollo.io
# ─────────────────────────────────────────────
# Your Apollo.io API key (Settings → Integrations → API Keys)
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
#  Google Sheets
# ─────────────────────────────────────────────
# The long ID in the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google service account JSON credentials file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─────────────────────────────────────────────
#  Error Notifications
# ─────────────────────────────────────────────
# Email to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail account used to SEND alert emails
# (can be the same as NOTIFICATION_EMAIL)
SMTP_USER=your_gmail@gmail.com

# Gmail App Password (NOT your account password)
# Generate at: myaccount.google.com → Security → App Passwords
SMTP_PASS=your_16_char_app_password

# ─────────────────────────────────────────────
#  Optional Overrides
# ─────────────────────────────────────────────
# Cron expression for scheduled run (default: 7:00 AM Eastern daily)
# CRON_SCHEDULE=0 7 * * *

# Maximum new leads to add per run (default: 25)
# MAX_LEADS_PER_RUN=25
