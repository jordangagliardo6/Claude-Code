# ─────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────
# Grab your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The spreadsheet ID lives in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# ─────────────────────────────────────────────
# Scheduler timezone — do NOT change this
# ─────────────────────────────────────────────
TZ=America/New_York

# ─────────────────────────────────────────────
# Error alert email (optional)
# ─────────────────────────────────────────────
# If you want email alerts on failure, fill these in
# and uncomment the nodemailer block in src/workflow.js
ALERT_EMAIL=your_email@example.com
ALERT_EMAIL_PASSWORD=your_app_password_here
