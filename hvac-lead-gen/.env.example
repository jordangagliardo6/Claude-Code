# Apollo.io API Key — get it from app.apollo.io > Settings > Integrations > API
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Notification email for error alerts
ALERT_EMAIL=jgagliardo98@gmail.com

# Google OAuth credentials (from Google Cloud Console)
# Path to the credentials JSON file you download from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path where the OAuth token will be cached after first run
GOOGLE_TOKEN_PATH=./token.json
