# ─────────────────────────────────────────────────────────────
# HVAC Lead Generation — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────

# Apollo.io API key
# Get yours at: https://developer.apollo.io → API Keys
# Free plan: ~50 enrichments/month
# Basic plan ($49/mo): 1,000 enrichments/month (recommended for daily runs)
APOLLO_API_KEY=your_apollo_api_key_here

# Google Service Account credentials
# OPTION A (recommended): path to the downloaded JSON key file
GOOGLE_CREDENTIALS_PATH=/path/to/your/service-account-key.json

# OPTION B: inline JSON string (useful for Docker / CI / hosted environments)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ─── Optional overrides ───────────────────────────────────────

# Spreadsheet to write leads into (defaults to SW Michigan HVAC Leads sheet)
# Get the ID from the URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# Sheet tab name inside the spreadsheet (default: Sheet1)
# SHEET_TAB=Sheet1
