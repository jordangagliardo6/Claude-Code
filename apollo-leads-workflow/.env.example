# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
# Required plan: Apollo Basic ($49/mo) or above for the People Search endpoint.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1MkLyTOHTX9-GJiKi9V3_kgfFBAkPTMjyxwBJBho9ayI

# Path to your Google service-account credentials JSON file.
# Defaults to ./credentials.json if not set.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Email alerts (optional) ──────────────────────────────────────────────────
# If set, the workflow will email you when Apollo fails or the sheet can't be written.
# Remove or leave blank to skip email alerts (errors still print to console).
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail example (use an App Password, not your main password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
