# Apollo.io API key — get from https://developer.apollo.io > API Keys
# Requires Basic plan ($49/mo) or higher for People Search + phone enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — the long ID from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Path to your Google service account JSON credentials file
# See setup guide below for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Your email for error notifications (sent via console log — extend to email if needed)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per scheduled run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25
