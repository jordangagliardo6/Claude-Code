# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Generator — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io/  →  API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Set to true to use the Apollo /people/match enrichment endpoint to reveal
# phone numbers that are masked in search results.
# WARNING: Costs 1 Apollo credit per matched contact. Default: false.
ENABLE_ENRICHMENT=false

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# The tab name inside your spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ── Google Service Account Credentials ───────────────────────────────────────
# Option A (recommended): Point to your downloaded service-account JSON file.
#   Place the file in this directory and set the path below.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-credentials.json

# Option B: Inline the credentials as environment variables instead of a file.
#   Uncomment and fill these in if you prefer not to use a JSON file.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-generator@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"

# ── Workflow Settings ─────────────────────────────────────────────────────────
# Maximum new leads to add per daily run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ── Error Notifications ───────────────────────────────────────────────────────
# Your email address — receives alerts when Apollo or Sheets fails.
NOTIFICATION_EMAIL=your_email@example.com

# Gmail SMTP (or any SMTP provider). For Gmail, use an App Password:
#   https://myaccount.google.com/apppasswords
# Leave blank to disable email alerts (errors still print to console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
