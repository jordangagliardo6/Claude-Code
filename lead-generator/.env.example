# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Generator — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Requires a paid Apollo plan (Professional or above) for the People Search API.
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID of the spreadsheet to append leads to.
# Found in the sheet URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# ── Google Auth — Option A: Service Account (recommended for automation) ──────
# Best for unattended cron jobs — no browser needed after setup.
#
# Setup steps:
#   1. Go to https://console.cloud.google.com
#   2. Enable the Google Sheets API for your project
#   3. Create a Service Account: IAM & Admin → Service Accounts → Create
#   4. Create and download a JSON key for that service account
#   5. Share your Google Sheet with the service account email (give Editor access)
#   6. Set the path to that JSON file below
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ── Google Auth — Option B: OAuth2 (one-time browser authorization) ───────────
# Use this if you prefer OAuth instead of a service account.
#
# Setup steps:
#   1. Go to https://console.cloud.google.com
#   2. Enable the Google Sheets API
#   3. Create OAuth 2.0 Credentials: APIs & Services → Credentials → Create
#      Choose "Desktop app" as the application type
#   4. Run the one-time auth script:
#        node auth-helper.js
#      It will open a browser, ask you to authorize, and print a refresh token.
#   5. Paste the values below (comment out Option A first)
#
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for the daily run. Default runs at 7am Eastern Time.
# The timezone is hardcoded to America/New_York in index.js (handles DST).
# Override here if needed, e.g. '0 8 * * *' for 8am.
CRON_SCHEDULE=0 7 * * *
