# Apollo.io API Key — get it at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID
# From the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials — choose ONE of the two options below:

# Option A: path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option B: paste the entire JSON as a single-line string (useful for cloud hosting)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: SendGrid API key for email error alerts
# If omitted, errors are logged to console only
# SENDGRID_API_KEY=your_sendgrid_api_key_here
