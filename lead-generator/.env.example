# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Your Apollo API key — found at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Spreadsheet ID — the long string in the Google Sheets URL between /d/ and /edit
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account JSON key file
# See README for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ─── Lead Generation Settings ────────────────────────────────────────────────
# Max new leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25

# ─── Error Notifications (optional) ──────────────────────────────────────────
# Set these to receive email alerts when a run fails.
# Leave blank to use console-only error logging.
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP config (Gmail example shown — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
