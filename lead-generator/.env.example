# Apollo.io API Key
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Extract from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google OAuth credentials (from Google Cloud Console)
# These come from your downloaded credentials.json file
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Google OAuth refresh token (generated during first-run setup)
# Run: node setup-oauth.js to generate this
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Notification email (for error alerts)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25
