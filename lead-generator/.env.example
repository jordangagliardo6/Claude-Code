# Apollo.io API Key
# Get it at: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets – Spreadsheet ID
# Found in the sheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Sheets – Tab/sheet name (default: Sheet1)
GOOGLE_SHEET_TAB=Leads

# Path to your Google OAuth credentials JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials/credentials.json

# Path where the OAuth token is stored after first auth (auto-created)
GOOGLE_TOKEN_PATH=./credentials/token.json

# --- Error notification email ---
# Nodemailer SMTP settings — Gmail example shown below.
# For Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=jgagliardo98@gmail.com
NOTIFY_EMAIL_FROM=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jgagliardo98@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25
