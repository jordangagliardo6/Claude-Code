# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Apollo.io API key (from https://app.apollo.io/#/settings/integrations/api)
# Requires a paid Apollo plan for the People Search endpoint.
APOLLO_API_KEY=your_apollo_api_key_here

# Path to your Google service-account JSON keyfile.
# See SETUP.md for how to create and download this file.
GOOGLE_SERVICE_ACCOUNT_FILE=google-credentials.json

# Google Sheets spreadsheet ID — the long string in the URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Email address for error alerts (requires nodemailer config in lead-generator.js)
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Set to "true" to fire one run immediately on startup (for testing)
RUN_NOW=false

# Set to "true" to run the connection check only (no leads pulled)
VERIFY=false
