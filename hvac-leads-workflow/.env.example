# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io/keys/
# Requires Apollo paid plan for people search + enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Share this sheet with your service account email (see credentials.json)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# The name of the sheet tab inside that spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB_NAME=Sheet1

# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Notifications ────────────────────────────────────────────────────────────
# Your email address — receives error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail "App Password" for sending error alerts
# Generate at: https://myaccount.google.com/apppasswords
# Leave blank to skip email alerts (errors still log to console)
GMAIL_APP_PASSWORD=

# ─── Workflow Config ──────────────────────────────────────────────────────────
# How many new leads to pull per run (keep low to stay manageable)
MAX_LEADS_PER_RUN=25

# Comma-separated city names to target (no quotes needed here)
TARGET_CITIES=St. Joseph,Benton Harbor,Kalamazoo,Holland,Grand Haven,Muskegon,South Haven
