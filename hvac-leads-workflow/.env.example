# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# Get your key at: https://app.apollo.io/#/settings/integrations/api
# ─────────────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets
# Spreadsheet ID is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=1Wm5m8AWGeZJDdBnHNxtd0SosrrEH_aQrzZmYUXnTMoE

# Google Service Account credentials — pick ONE option:
#
# Option A (recommended for local use): path to your downloaded JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
#
# Option B (for hosted/cloud environments): paste the entire JSON as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─────────────────────────────────────────────────────────────────────────────
# Scheduler
# Default: 7:00 AM every day (node-cron syntax, Eastern Time)
# Override if you need a different time — format: "minute hour * * *"
# ─────────────────────────────────────────────────────────────────────────────
# CRON_SCHEDULE=0 7 * * *

# ─────────────────────────────────────────────────────────────────────────────
# Email alerts (optional — set EMAIL_ENABLED=true to get notified on errors)
# For Gmail: use an App Password, not your regular password.
#   Enable at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
ALERT_EMAIL=jgagliardo98@gmail.com
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
