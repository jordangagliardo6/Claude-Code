# ─────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────
# Find your API key at: https://app.apollo.io/settings/integrations/api
# Requires Apollo Basic plan or above for People Search + phone numbers
APOLLO_API_KEY=your_apollo_api_key_here

# Set to "true" if your Apollo plan doesn't return phones in search results.
# Each enrichment call costs 1 Apollo export credit. Leave "false" to skip
# enrichment and only keep leads where search already returns a phone.
ENRICH_FOR_PHONES=false

# Max leads to pull per scheduled run (default 25)
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The ID of your leads spreadsheet (already pre-filled below)
SPREADSHEET_ID=1rJsYIBDjJT-df54VoWAsCC2Fq_UN6zc3XFVqqX8sun8

# Path to your Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# ─────────────────────────────────────────────
# Scheduler
# ─────────────────────────────────────────────
# Default: 7:00 AM Eastern Time (UTC-5 standard / UTC-4 daylight saving)
# Standard time  (Nov–Mar): 0 12 * * *   (12:00 UTC = 7:00 AM EST)
# Daylight saving (Mar–Nov): 0 11 * * *  (11:00 UTC = 7:00 AM EDT)
# Update this when clocks change, or run the cron on a machine set to ET.
CRON_SCHEDULE=0 12 * * *

# ─────────────────────────────────────────────
# Error Alert Email (optional — leave blank to use console-only logging)
# ─────────────────────────────────────────────
ALERT_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP example (use an App Password, not your real password):
#   https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
