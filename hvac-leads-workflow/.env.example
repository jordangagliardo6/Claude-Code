# ── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# Path to your Google service account JSON key (see README for how to create one)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json

# ── Email alerts (optional — leave blank to disable) ──────────────────────────
# Uses Gmail SMTP. If you use 2FA, create an App Password at:
#   https://myaccount.google.com/apppasswords
ALERT_EMAIL_TO=your_email@gmail.com
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password

# ── Run settings ──────────────────────────────────────────────────────────────
# How many leads to pull per run (keep ≤25 to stay under Apollo free tier limits)
MAX_LEADS_PER_RUN=25

# Cron schedule: "0 7 * * *" = 7:00 AM every day
# Uses America/New_York (Eastern Time)
CRON_SCHEDULE=0 7 * * *
