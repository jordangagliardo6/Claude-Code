# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
# NOTE: Requires a PAID Apollo plan (Basic or above) to use the People Search API.
# Free plans cannot access the prospecting endpoint.
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# This is the long ID in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Default: SW Michigan HVAC Leads master sheet
SPREADSHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Google service account credentials file path (relative to this directory)
# See README.md for how to create and configure this
GOOGLE_CREDENTIALS_FILE=./credentials.json

# Optional: Name of the sheet tab to write to (default: "Sheet1")
SHEET_TAB_NAME=Sheet1

# Optional: Email address to send error alerts to
# (Uses Gmail via SMTP if configured, otherwise logs to console)
ALERT_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Timezone for the scheduler (default: America/New_York for 7am Eastern)
TIMEZONE=America/New_York

# Cron schedule (default: 7am every day)
CRON_SCHEDULE=0 7 * * *
