# ── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Tab name inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# ── Optional: email alert on workflow failure ─────────────────────────────────
# Uncomment and fill in if you want email error notifications.
# See README for nodemailer setup.
# ALERT_EMAIL=you@example.com
