# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# Get your API key: https://developer.apollo.io → Settings → API Keys
# ─────────────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets
# Spreadsheet ID is the long string in the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials — choose ONE option:
#
# Option A (recommended): Path to your downloaded service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-credentials.json
#
# Option B: Paste the entire service account JSON inline (good for cloud/Docker)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project",...}

# ─────────────────────────────────────────────────────────────────────────────
# Email alerts (optional)
# If set, errors are emailed to ALERT_EMAIL. If not set, errors log to run.log only.
# For Gmail: use an App Password (not your main password):
#   Google Account → Security → 2-Step Verification → App Passwords
# ─────────────────────────────────────────────────────────────────────────────
ALERT_EMAIL=your-email@gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
