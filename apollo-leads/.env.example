# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1MkLyTOHTX9-GJiKi9V3_kgfFBAkPTMjyxwBJBho9ayI

# Path to your Google service account JSON file (see README for how to create one)
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# ─── Email Alerts (optional — leave blank to skip email notifications) ────────
# SMTP credentials for error/success email alerts
ALERT_EMAIL_TO=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Schedule ─────────────────────────────────────────────────────────────────
# Cron expression for 7:00 AM Eastern Time (ET = UTC-5 in winter, UTC-4 in summer)
# Default: '0 12 * * *' = 7am ET during EST (winter). Adjust to '0 11 * * *' for EDT.
# Or use: TZ=America/New_York with '0 7 * * *' (requires TZ env support on your system)
CRON_SCHEDULE=0 7 * * *
TZ=America/New_York

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Max leads to pull per run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25
