# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to the Service Account JSON key file you downloaded from Google Cloud.
# Example: ./credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# The ID of your Google Spreadsheet.
# Copy it from the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# (Optional) Name of the tab/sheet inside the spreadsheet. Defaults to "Sheet1".
GOOGLE_SHEET_TAB=Sheet1

# ─── Error Notifications ──────────────────────────────────────────────────────
# (Optional) Your email address for error alerts.
# Requires nodemailer + SMTP settings to actually send email — see logger.js.
NOTIFY_EMAIL=jgagliardo98@gmail.com
