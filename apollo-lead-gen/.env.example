# ─── Apollo.io ───────────────────────────────────────────────────
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────
# The ID portion of your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Email Alerts (optional) ─────────────────────────────────────
# If set, errors are emailed here in addition to being logged to error.log.
# Leave blank to disable email alerts.
NOTIFY_EMAIL=your_email@example.com

# SMTP settings for sending alert emails (Gmail example below).
# For Gmail: use an App Password, not your regular password.
# App passwords: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
