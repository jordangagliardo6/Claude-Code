# Apollo.io API Key
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# From the URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the sheet tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Google Service Account credentials file path
# See README for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-credentials.json

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Notification email for error alerts (optional)
NOTIFICATION_EMAIL=your_email@gmail.com

# Cron schedule — default is 7:00am Eastern Time (12:00 UTC)
# Format: "minute hour * * *"
CRON_SCHEDULE=0 12 * * *
