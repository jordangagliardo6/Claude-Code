# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Your Apollo API key — Settings → Integrations → API Keys in Apollo
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Option A — Path to a service account JSON key file (recommended for local dev)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Option B — Inline JSON (recommended for deployment / CI environments)
# Paste the entire service account JSON on one line, wrapped in single quotes
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Set to "true" to trigger one run immediately on startup (useful for testing)
RUN_NOW=false

# Max leads to add per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# ─── Error notifications (optional) ──────────────────────────────────────────
# If set, critical errors are written to this file in addition to the console
ERROR_LOG_PATH=./error.log
