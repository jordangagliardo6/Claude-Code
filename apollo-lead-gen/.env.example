# ─────────────────────────────────────────────────────
# Apollo.io
# Get your key at: https://developer.apollo.io → API Keys
# ─────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────
# Google Sheets
# GOOGLE_SPREADSHEET_ID: the long ID in your sheet URL
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# GOOGLE_CREDENTIALS_PATH: path to your service account JSON
#   (download from Google Cloud Console → Service Accounts)
# GOOGLE_SHEET_TAB: the tab name inside the spreadsheet (default: Leads)
# ─────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_TAB=Leads

# ─────────────────────────────────────────────────────
# Workflow settings
# MAX_LEADS_PER_RUN: how many new leads to add each morning (default: 25)
# CRON_SCHEDULE: cron syntax for the schedule (default: 7:00 AM daily)
# ─────────────────────────────────────────────────────
MAX_LEADS_PER_RUN=25
CRON_SCHEDULE=0 7 * * *

# ─────────────────────────────────────────────────────
# Email error alerts (optional — leave all SMTP_ fields blank to skip)
# Easiest setup: use Gmail with an App Password
#   https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
