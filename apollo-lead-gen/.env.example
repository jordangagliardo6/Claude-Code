# --- Apollo.io -------------------------------------------------------------
# developer.apollo.io -> Settings -> API -> API Keys
APOLLO_API_KEY=

# --- Google Sheets / Drive --------------------------------------------------
# OAuth client created in Google Cloud Console (Desktop app type).
# See README.md "Google OAuth setup" for step-by-step instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated automatically the first time you run `npm run auth:google`.
# Leave blank until then.
GOOGLE_REFRESH_TOKEN=

# The spreadsheet you want leads appended to.
# Copy the ID out of the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=
# Tab name inside that spreadsheet that holds the lead table.
GOOGLE_SHEET_TAB_NAME=Leads

# --- Error alerting (optional but recommended) ------------------------------
# If these are left blank, errors are only logged to the console.
# Any SMTP provider works (Gmail App Password, SendGrid, Mailgun, etc).
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=465
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASS=
