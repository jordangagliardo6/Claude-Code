# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api_keys
# Requires Apollo Professional plan or higher for People Search API access.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file.
# Steps to create one:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or use existing) → Enable "Google Sheets API"
#   3. IAM & Admin → Service Accounts → Create → Download JSON key
#   4. Open your Google Sheet → Share → add the service account email (Editor)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
# Current master sheet: SW Michigan HVAC Leads — New Sept 17 2026
GOOGLE_SPREADSHEET_ID=1AeBxj0lE86Bkn7w00B5SW_z0DZsaho3shJoKddMKqqE

# Name of the sheet tab inside the spreadsheet (usually "Sheet1")
GOOGLE_SHEET_NAME=Sheet1

# ─── Error Notifications (optional) ──────────────────────────────────────────
# If set, errors will trigger an email alert via Gmail SMTP.
# Leave blank to log errors to console only.
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=your_gmail_address@gmail.com
# Use a Gmail App Password (not your main password):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password_here
