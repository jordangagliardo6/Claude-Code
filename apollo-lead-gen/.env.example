# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Apollo.io ---
# Apollo dashboard > Settings > Integrations > API. Needs a plan with
# people search + enrichment access.
APOLLO_API_KEY=

# Publicly reachable URL pointing at this app's webhook server
# (src/phoneWebhookServer.js), used by Apollo to deliver revealed phone
# numbers asynchronously. Leave blank to skip phone reveal (the workflow
# will only use numbers Apollo already exposes directly, which is a much
# smaller subset of leads).
# Example with ngrok during testing: https://abc123.ngrok-free.app/apollo/phone-webhook
PHONE_REVEAL_WEBHOOK_URL=
WEBHOOK_PORT=3300

# --- Google Sheets ---
# OAuth client from Google Cloud Console (Application type: Desktop app).
# See README "Google OAuth setup" for step-by-step instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated once by running: npm run google-auth
GOOGLE_REFRESH_TOKEN=

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=
# Tab/sheet name within the spreadsheet that holds the leads table
GOOGLE_SHEET_TAB=Leads

# --- Error alerting (optional but recommended) ---
# If SMTP_* values are present, errors are emailed in addition to being
# logged to the console. If omitted, errors are only logged to the console.
ALERT_EMAIL_TO=jgagliardo98@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
