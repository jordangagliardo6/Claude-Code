# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The tab name within the spreadsheet (must match exactly, case-sensitive)
GOOGLE_SHEET_TAB=Leads

# Path to your Google service account credentials JSON file
# See README.md → Step 2 for how to generate this file
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Notifications ─────────────────────────────────────────────────────────────
# Optional: receives error alerts (requires nodemailer setup — see README)
NOTIFICATION_EMAIL=your_email@example.com
