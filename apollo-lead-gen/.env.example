# ─── Apollo.io ──────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
# NOTE: People Search API requires a paid Apollo plan (Basic or above)
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets (Service Account) ────────────────────────────────────────
# Path to your Google Service Account JSON key file.
# See SETUP.md for step-by-step instructions on creating one.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# ─── Optional: Run immediately on startup (useful for manual test runs) ──────
# Set to true to fire one run as soon as the process starts, then schedule normally.
# Remove or set to false for scheduled-only mode.
RUN_NOW=false

# ─── Optional: Email alerts via nodemailer ───────────────────────────────────
# Uncomment and fill in if you want real email notifications (see index.js).
# EMAIL_USER=your_gmail_address@gmail.com
# EMAIL_PASS=your_gmail_app_password
