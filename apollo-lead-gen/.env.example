# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID is in the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=1MkLyTOHTX9-GJiKi9V3_kgfFBAkPTMjyxwBJBho9ayI

# The tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# ─── Lead Settings ────────────────────────────────────────────────────────────
# Maximum new leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25

# ─── Error Notifications ──────────────────────────────────────────────────────
# Email address to notify if the run fails
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP (App Password — NOT your regular Gmail password)
# Enable at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
