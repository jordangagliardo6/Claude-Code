# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get from: app.apollo.io → Settings → Integrations → API
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Path to your Google service account key JSON file (recommended for automation)
# See setup guide below for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ─── Error Notifications ───────────────────────────────────────────────────────
# Where to send alert emails when a run fails
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail credentials for sending error alerts (use an App Password, not your main password)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_16_char_app_password

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Max leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25

# Timezone for the 7am cron schedule
TIMEZONE=America/New_York
