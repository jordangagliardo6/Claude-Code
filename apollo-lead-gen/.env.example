# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# Pre-filled with your existing sheet:
GOOGLE_SHEET_ID=1EVGUTgiRvTa5FdoGjLBtHf3yvR_mUFpsBpIUFMaDIaM

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ─── Error Notifications ──────────────────────────────────────────────────────
# Address that receives error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail "App Password" (not your regular password).
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google account)
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ─── Optional ─────────────────────────────────────────────────────────────────
# Max leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25
