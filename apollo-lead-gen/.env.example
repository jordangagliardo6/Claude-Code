# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# ─── Google Auth (choose ONE method) ─────────────────────────────────────────
#
# OPTION A — Service Account (recommended for automation):
#   1. Create a service account in Google Cloud Console
#   2. Download the JSON key file → save to ./credentials/service-account.json
#   3. Share your Google Sheet with the service account email address
#   4. Set GOOGLE_AUTH_METHOD=service_account
#
# OPTION B — OAuth2 (use if you prefer personal account access):
#   1. Create OAuth2 Desktop credentials in Google Cloud Console
#   2. Download the JSON → save to ./credentials/oauth2-client.json
#   3. Run: npm run auth   (opens browser once to authorize)
#   4. Set GOOGLE_AUTH_METHOD=oauth2
#
GOOGLE_AUTH_METHOD=service_account

# Path to your credentials file (relative to this directory)
GOOGLE_CREDENTIALS_FILE=./credentials/service-account.json

# ─── Notifications ────────────────────────────────────────────────────────────
# Email to notify on errors (optional — requires SMTP config below)
NOTIFY_EMAIL=jgagliardo98@gmail.com

# SMTP settings for error notifications (all optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
