# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get this from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The long ID in your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your downloaded service account JSON key file
# (see setup instructions — default assumes credentials.json in this folder)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials.json

# Name of the tab inside the spreadsheet to write to (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ─── Error notifications (optional) ──────────────────────────────────────────
# If set, you'll receive an email when a run fails
NOTIFICATION_EMAIL=your_email@gmail.com

# SMTP credentials — for Gmail use an App Password:
#   Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
