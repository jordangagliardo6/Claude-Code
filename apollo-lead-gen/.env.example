# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# The ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab inside your spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google OAuth2 credentials JSON (downloaded from Google Cloud Console)
# Default: ./credentials.json (place it next to this file)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Email notifications (optional) ────────────────────────────────────────────
# If set, errors are emailed here in addition to being logged to the console.
NOTIFICATION_EMAIL=your_email@example.com

# SMTP settings — Gmail example (use an App Password, not your real password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
