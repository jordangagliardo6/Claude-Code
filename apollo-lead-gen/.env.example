# =============================================
# Apollo.io
# Get from: https://developer.apollo.io → API Keys
# Free tier: 50 enrichments/month
# Basic ($49/mo): 1,000 exports/month (recommended for daily runs)
# =============================================
APOLLO_API_KEY=your_apollo_api_key_here

# =============================================
# Google Sheets
# The spreadsheet ID is the long string in the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# =============================================
GOOGLE_SHEET_ID=your_google_sheet_id_here

# =============================================
# Google Service Account Credentials (choose ONE)
#
# Option A — Path to downloaded JSON key file (local use)
# Set this to the path of the service-account-key.json you downloaded
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B — Paste the entire JSON as a single-line string (server / cloud use)
# Copy the contents of service-account-key.json and paste it here as one line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# =============================================

# =============================================
# Error Alert Email (optional)
# If SMTP credentials are set, errors will be emailed here instead of
# (or in addition to) console output.
# =============================================
NOTIFICATION_EMAIL=your@email.com

# Gmail SMTP — requires 2FA enabled + an App Password
# Create one at: https://myaccount.google.com/apppasswords
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
