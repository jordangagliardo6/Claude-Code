# ──────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Apollo.io ─────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
# IMPORTANT: /mixed_people/search requires Basic plan ($49/mo) or higher.
# Free plan only searches your saved CRM contacts, not the full Apollo database.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets (Service Account — recommended for scheduled scripts) ────────
#
# Option A: Paste the full service account JSON as a single line
# How to create a service account:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Click "Create credentials" → "Service account"
#   3. Grant it no project roles (it only needs Sheets access)
#   4. Under the service account → Keys → Add Key → JSON
#   5. Download the JSON file
#   6. Enable Google Sheets API: console.cloud.google.com/apis/library/sheets.googleapis.com
#   7. Share the target spreadsheet with the service account email (editor access)
#   8. Paste the JSON content below as one line (or use Option B)
#
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Option B: Path to the downloaded JSON key file (leave GOOGLE_SERVICE_ACCOUNT_JSON blank)
# GOOGLE_KEY_FILE=/path/to/service-account-key.json

# ── Optional: Email Alerts via SMTP ───────────────────────────
# Uncomment and fill in to enable automated error email alerts.
# Requires wiring nodemailer in the notifyError() function in index.js.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
