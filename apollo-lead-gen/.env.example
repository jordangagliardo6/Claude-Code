# ─────────────────────────────────────────────────────────
#  Apollo.io
#  Get your key: app.apollo.io → Settings → Integrations → API
# ─────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────
#  Google Sheets
#  Spreadsheet ID is the long string in the sheet URL:
#  https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
# ─────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account JSON key file.
# Default: ./credentials/service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account-key.json

# ─────────────────────────────────────────────────────────
#  Optional: sheet tab name (default: Sheet1)
# ─────────────────────────────────────────────────────────
SHEET_TAB_NAME=Sheet1
