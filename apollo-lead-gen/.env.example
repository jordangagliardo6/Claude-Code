# ─────────────────────────────────────────────
#  Apollo.io
# ─────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
#  Google Sheets
# ─────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet tab name (default: Sheet1)
GOOGLE_SHEET_NAME=Leads

# Path to your service-account JSON key file
# Download from Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# ─────────────────────────────────────────────
#  Run settings
# ─────────────────────────────────────────────
# Max leads to add per run (keep <= 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00 AM Eastern (12:00 UTC)
# Uses node-cron format: second minute hour day month weekday
CRON_SCHEDULE=0 12 * * *

# ─────────────────────────────────────────────
#  Email alerts (optional)
# ─────────────────────────────────────────────
# Set ALERT_EMAIL to receive error notifications. Requires Gmail app password.
ALERT_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
