# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
#
# Your pre-created sheet ID (HVAC SW Michigan Leads):
GOOGLE_SHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# Path to your Google service account JSON key file.
# Default: ./credentials.json in the project root.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Run Settings ───────────────────────────────────────────────────────────────
# Max leads to pull per daily run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# ── Email Notifications (optional) ────────────────────────────────────────────
# Uncomment these and install nodemailer to get email alerts on errors.
# See src/notify.js for setup instructions.
#
# NOTIFY_EMAIL=jgagliardo98@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password
