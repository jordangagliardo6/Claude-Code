# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at: https://developer.apollo.io → API Keys
# Requires Apollo Basic plan ($49/mo) or higher for people search API access.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID is in the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
#
# Your existing "SW Michigan HVAC Leads" sheet (pre-filled for you):
GOOGLE_SHEET_ID=1Loehf0bQlNdSwvW8wFbK5VFpFt_cDSoRN8nHY50aHWo

# Name of the tab/sheet within the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# ─── Error Notifications ──────────────────────────────────────────────────────
# Email address to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional: SMTP credentials for email alerts (leave blank to disable email alerts)
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Run Settings ─────────────────────────────────────────────────────────────
# Max leads to pull per daily run (keep at 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# How many extra leads to fetch from Apollo before dedup filtering
# (fetch more than needed so dedup doesn't leave you short)
APOLLO_FETCH_MULTIPLIER=4
