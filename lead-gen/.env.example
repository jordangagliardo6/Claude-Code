# ─────────────────────────────────────────────
# Apollo.io
# Get your key: https://app.apollo.io/#/settings/integrations/api
# ─────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# GOOGLE_SPREADSHEET_ID: the long ID in your sheet URL
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# GOOGLE_CREDENTIALS_PATH: path to your service-account JSON key file
# GOOGLE_SHEET_NAME: the tab name inside the spreadsheet (default: Leads)
# ─────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEET_NAME=Leads

# ─────────────────────────────────────────────
# Workflow settings
# ─────────────────────────────────────────────
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────
# Email alerts (optional)
# Leave ALERT_EMAIL blank to use console-only logging.
# For Gmail: enable 2FA, generate an App Password, use that as SMTP_PASS.
# ─────────────────────────────────────────────
ALERT_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
