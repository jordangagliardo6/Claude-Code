# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# This is the ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Your "SW Michigan HVAC Leads" sheet ID:
GOOGLE_SPREADSHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Google Service Account credentials (from the JSON key file)
# After creating a service account in Google Cloud Console, download the JSON key
# and paste the values from it here — OR set GOOGLE_SERVICE_ACCOUNT_KEY_FILE below.

# Option A: Inline JSON (paste the entire JSON key file contents as one line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"..."}

# Option B: Path to the JSON key file (easier to set up locally)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# Notification email (for error alerts)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Max leads to pull per run (default 25)
MAX_LEADS_PER_RUN=25
