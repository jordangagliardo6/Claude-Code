# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Found at: https://developer.apollo.io/ → API Keys
# Requires a paid Apollo plan for People Search (Basic or above).
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets — choose ONE of the two auth options below ─────────────────

# Option A (Recommended): Service Account JSON key file
# Steps:
#   1. Go to Google Cloud Console → IAM & Admin → Service Accounts
#   2. Create a service account → create + download a JSON key
#   3. Share your Google Sheet with the service account email (Editor role)
#   4. Set this to the absolute path of the downloaded JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option B: OAuth2 with a stored refresh token
# Steps:
#   1. Go to Google Cloud Console → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Desktop app type)
#   3. Run the OAuth flow once (see README) to get a refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Spreadsheet ──────────────────────────────────────────────────────────────
# The ID from the Google Sheet URL. Default is set in src/config.js.
# Override here only if you want to point at a different sheet.
# SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# The tab name inside the spreadsheet (usually "Sheet1").
# SHEET_TAB_NAME=Sheet1

# ─── Error Alerts (Gmail) ─────────────────────────────────────────────────────
# Your Gmail address and an App Password (not your regular password).
# Steps to create an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
# If not set, errors are logged to console only (no email alert).
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Override the address that receives error alerts (defaults to jgagliardo98@gmail.com).
# ERROR_EMAIL_TO=jgagliardo98@gmail.com
