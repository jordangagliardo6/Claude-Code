# ─────────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Apollo.io API Key
# Get it from: https://developer.apollo.io → API Keys
# Free tier: 50 people enrichments/month (each phone lookup = 1 credit)
# Basic plan ($49/mo): 1,000 enrichments/month — recommended for daily runs
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# Path to your Google Service Account JSON key file.
# See SETUP.md → "Step 2: Google Sheets" for how to generate this file.
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/service-account.json

# ─── Run Settings ────────────────────────────────────────────────

# Maximum new leads to add per daily run (default: 25)
MAX_LEADS_PER_RUN=25

# ─── Error Email Notifications (optional) ────────────────────────
# If any of these are blank, errors are only logged to the console.
# For Gmail: enable 2-Step Verification, then create an App Password at:
# https://myaccount.google.com/apppasswords

# Where to send error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP credentials for sending alerts (Gmail shown as example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password_here
