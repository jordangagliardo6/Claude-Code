# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Pull the Spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google Service Account JSON key file
# See SETUP GUIDE below for how to create one
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Email Alerts (Optional) ──────────────────────────────────────────────────
# If either EMAIL_FROM or EMAIL_APP_PASSWORD is blank, errors go to console only.
# Create a Gmail App Password at: https://myaccount.google.com/apppasswords
EMAIL_FROM=your_gmail@gmail.com
EMAIL_TO=jgagliardo98@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Max new leads to add per daily run
MAX_LEADS_PER_RUN=25
