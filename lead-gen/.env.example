# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account credentials JSON file.
# Download from: Google Cloud Console → IAM & Admin → Service Accounts → Keys
# Then share your spreadsheet with the service account email address.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Notifications ───────────────────────────────────────────────────────────
# Email address to notify on errors (console log only — no SMTP needed)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
