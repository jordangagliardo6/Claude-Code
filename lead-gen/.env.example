# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your downloaded service account JSON file
# OR paste the entire JSON as a single-line string in GOOGLE_CREDENTIALS_JSON
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ─── Alerts ───────────────────────────────────────────────────────────────────
# Email address to notify on error (optional — leave blank to skip email alerts)
ALERT_EMAIL=jgagliardo98@gmail.com

# SMTP settings for error email alerts (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here

# ─── Run config ───────────────────────────────────────────────────────────────
# Max new leads to add per run
MAX_LEADS_PER_RUN=25

# Cron schedule — default: 7:00 AM Eastern every day
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=America/New_York
