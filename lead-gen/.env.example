# Apollo.io API key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Drive folder ID where spreadsheets will be created
# Find it in the URL of your Drive folder: drive.google.com/drive/folders/FOLDER_ID_HERE
SPREADSHEET_PARENT_FOLDER_ID=your_drive_folder_id_here

# Email address to notify on errors
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP settings for error email alerts (Gmail example)
# For Gmail: use an App Password, not your regular password
# Generate one at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
