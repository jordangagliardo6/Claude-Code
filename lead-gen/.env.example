# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
# Requires a paid plan (Basic $49/mo+) to use the People Search endpoint
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# The tab name inside the spreadsheet (check the tab at the bottom of your sheet)
# Leave blank to always use the first tab
GOOGLE_SHEET_TAB=

# Path to your Google Service Account credentials JSON file (see SETUP.md)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Workflow settings ────────────────────────────────────────────────────────
# Maximum new leads to add per run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ─── Error notifications ──────────────────────────────────────────────────────
# Email address to notify when a run fails
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP — use a Gmail App Password (not your regular password)
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
