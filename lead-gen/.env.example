# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get this from: https://developer.apollo.io/ → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────────
# The ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_ID=your_google_sheet_id_here

# Option A: path to the downloaded service account key file (local use)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account.json

# Option B: paste the entire JSON on one line (CI / GitHub Actions)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Notifications ──────────────────────────────────────────────────────────────
# Email shown in console error alerts (no SMTP configured by default)
ALERT_EMAIL=jgagliardo98@gmail.com
