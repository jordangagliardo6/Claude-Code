# ─── Apollo.io ──────────────────────────────────────────────────────────────
# Get your API key: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The long ID in your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The name of the tab/sheet inside that spreadsheet (default: Leads)
GOOGLE_SHEET_NAME=Leads

# ─── Google Service Account Auth (choose ONE method) ─────────────────────────
# Method A — path to the JSON key file you downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-credentials.json

# Method B — paste the entire JSON inline (useful on Render/Railway/Heroku)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Optional: Email alerts on errors ────────────────────────────────────────
# Uncomment and fill in all four vars to enable email notifications.
# Uses Gmail App Passwords (https://support.google.com/accounts/answer/185833).
# NOTIFICATION_EMAIL=jgagliardo98@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_sender@gmail.com
# SMTP_PASS=your_16_char_app_password
