# ─────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or credentials.json to git.
# ─────────────────────────────────────────────────────────────

# Apollo.io
# Get your key at: https://developer.apollo.io → API Keys
# Requires a Basic plan ($49/mo) or higher for people search.
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets
# The ID is in your spreadsheet URL:
#   docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Path to your Google service account credentials JSON file.
# See setup instructions below for how to create this file.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Name of the sheet tab inside the spreadsheet (usually "Sheet1").
GOOGLE_SHEET_TAB=Sheet1

# ─── Email Notifications (optional but recommended) ─────────
# Used to alert you when Apollo fails or the sheet write fails.
# For Gmail: create an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)

NOTIFICATION_EMAIL=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# ─── Timezone ───────────────────────────────────────────────
# Keeps the 7 AM cron schedule in Eastern time regardless of
# where your server is hosted.
TZ=America/New_York

# ─────────────────────────────────────────────────────────────
# HOW TO CREATE credentials.json (Google Service Account)
# ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or use an existing one)
# 3. Enable the "Google Sheets API":
#    APIs & Services → Enable APIs → search "Google Sheets API" → Enable
# 4. Create a service account:
#    APIs & Services → Credentials → Create Credentials → Service Account
#    Name it anything (e.g., "lead-gen-bot"), no roles needed, click Done
# 5. Click the service account → Keys tab → Add Key → JSON → Download
# 6. Save the downloaded file as credentials.json next to index.js
# 7. IMPORTANT: Share your Google Sheet with the service account email
#    (looks like: your-bot@your-project.iam.gserviceaccount.com)
#    Give it "Editor" access so it can append rows.
# ─────────────────────────────────────────────────────────────
