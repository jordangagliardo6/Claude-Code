# ─── Apollo.io ────────────────────────────────────────────────
# Get your key at https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────
# Copy from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Tab name inside the spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# ─── Error Notifications ──────────────────────────────────────
# Where to send error alerts (can be the same as SMTP_USER)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional SMTP — leave blank to skip email alerts and log only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
