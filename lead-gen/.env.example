# Apollo.io API Key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID (the long string in the URL after /spreadsheets/d/)
GOOGLE_SHEET_ID=1j1ooSkFSEc4G7vPv2T6XMGxgifaLcldfxNVm2231UYY

# Google Service Account credentials JSON (paste the entire JSON as one line, or use a file path)
# Option A: path to your downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-credentials.json
# Option B: inline JSON string (alternative to key file)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Email alert settings (optional — uses Gmail SMTP via nodemailer)
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=your_gmail@gmail.com
# For Gmail, use an App Password (not your real password): https://myaccount.google.com/apppasswords
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here

# How many leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25
