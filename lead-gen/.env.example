# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The full URL or just the spreadsheet ID from the Google Sheets URL
# URL format: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Path to your downloaded Google OAuth credentials JSON file
# Download from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# Path where the OAuth token will be saved after first authorization
GOOGLE_TOKEN_PATH=./credentials/google-token.json

# ─── Email Alerts (optional — leave blank to use console-only alerts) ────────
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=your@email.com

# Gmail App Password (not your regular password)
# Get it at: https://myaccount.google.com/apppasswords
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# ─── Workflow Tuning ─────────────────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern (12:00 UTC)
# Adjust if you observe daylight saving time shifts (EDT = UTC-4, EST = UTC-5)
CRON_SCHEDULE=0 12 * * *
