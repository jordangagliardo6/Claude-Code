# ─────────────────────────────────────────────────────────
#  Apollo.io
# ─────────────────────────────────────────────────────────
# Found at: app.apollo.io → Settings → Integrations → API
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────
#  Google Sheets
# ─────────────────────────────────────────────────────────
# The long ID in your sheet's URL:
#   docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google service-account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# ─────────────────────────────────────────────────────────
#  Notifications
# ─────────────────────────────────────────────────────────
# Your email for error alerts (logged to console if left blank)
NOTIFICATION_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────
#  Workflow tuning (optional — defaults shown)
# ─────────────────────────────────────────────────────────
MAX_LEADS_PER_RUN=25
CRON_SCHEDULE=0 7 * * *
TIMEZONE=America/New_York
