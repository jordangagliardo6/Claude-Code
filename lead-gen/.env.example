# =====================================================================
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# =====================================================================

# ------------------------------------------------------------------
# Apollo.io
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
# ------------------------------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here

# ------------------------------------------------------------------
# Google Sheets — Service Account (recommended)
#
# OPTION A: Path to the downloaded service account JSON key file
#   1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
#   2. Create a service account in your project
#   3. Create a JSON key and download it
#   4. Share the Google Sheet with the service account email
#      (the "client_email" field inside the JSON)
#
# OPTION B: Paste the entire JSON as a single-line string (for servers/Docker)
# ------------------------------------------------------------------

# Option A — point to the file:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/your/service-account-key.json

# Option B — inline JSON (uncomment and paste if not using Option A):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
