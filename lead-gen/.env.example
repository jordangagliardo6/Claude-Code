# ─── Copy this file to .env and fill in your values ─────────────────────────
# Never commit .env to git — it contains secrets.

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Find your API key at: https://app.apollo.io/#/settings/integrations/api
# Requires Apollo Basic plan or higher for People Search + Phone Reveal
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
#
# Your current "HVAC Leads - Southwest Michigan" sheet:
SPREADSHEET_ID=1MkLyTOHTX9-GJiKi9V3_kgfFBAkPTMjyxwBJBho9ayI

# Path to your Google service account credentials JSON file
# Default: ./credentials.json (place the file in the lead-gen/ folder)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Notifications ─────────────────────────────────────────────────────────────
# Email to notify on run failures (used if you enable nodemailer in notify.js)
ALERT_EMAIL=jgagliardo98@gmail.com

# ── Optional: SMTP for email alerts ───────────────────────────────────────────
# Uncomment and fill in to enable email error alerts (see notify.js)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
