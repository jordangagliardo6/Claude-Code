# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → API Keys
# Requires Basic plan ($49/mo) or higher for People Search + Enrichment API
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Path to your Google service account credentials JSON file
# See SETUP.md → Step 2 for how to create one
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials.json

# ─── Error Notifications ──────────────────────────────────────────────────────
# If set, emails you when the workflow errors out. Leave blank to skip.
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail App Password (not your regular password — generate at myaccount.google.com/apppasswords)
# Only needed if NOTIFY_EMAIL is set
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron expression for 7:00 AM Eastern Time (ET = UTC-5 standard, UTC-4 DST)
# "0 12 * * *" = noon UTC = 7 AM ET (standard time)
# "0 11 * * *" = 11 AM UTC = 7 AM ET (daylight saving time)
# Adjust the hour based on the current season, or use a timezone-aware library
CRON_SCHEDULE=0 12 * * *

# Max leads to pull per run (keep ≤25 to stay manageable)
MAX_LEADS_PER_RUN=25
