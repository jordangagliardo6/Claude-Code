# Apollo.io API key — from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID (the long ID from the sheet URL)
SPREADSHEET_ID=1HuLNVmDhxJCVgLKT07w9a4SXOJRzbhYKWX9Ul9W-p3A

# Optional: email alerts on error
# If left blank, errors are only logged to console
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=jgagliardo98@gmail.com
# Gmail App Password — https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_char_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in America/New_York — default is 7:00am daily
# Format: minute hour day month weekday
CRON_SCHEDULE=0 7 * * *
