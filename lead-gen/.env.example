# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The ID from the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Leads)
SHEET_TAB_NAME=Leads

# ─── Email notifications (optional) ──────────────────────────────────────────
# Sends an alert when Apollo returns 0 results or a write fails.
# Gmail users: use an App Password (not your real password).
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here
NOTIFY_EMAIL=jgagliardo98@gmail.com
