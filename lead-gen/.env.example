# ─────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Leads)
SHEET_NAME=Leads

# ─────────────────────────────────────────────
# Error notifications (optional — leave blank to skip email alerts)
# ─────────────────────────────────────────────
NOTIFICATION_EMAIL=you@example.com

# SMTP settings — example uses Gmail App Password
# For Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password_here
