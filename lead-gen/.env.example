# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets (Service Account) ─────────────────────────────────────────
# Option A — path to your downloaded service-account JSON key file:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# Option B — paste the entire JSON key as a single-line string (useful for env hosting):
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"..."}

# ─── Spreadsheet ──────────────────────────────────────────────────────────────
# The ID of your Google Sheet (from the URL: /spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=1Ox2uM8KR-_Fe-CIFrkGRdXMLQFnASqXXSaVCrzzao2o

# ─── Notification email (optional) ────────────────────────────────────────────
# If set, errors are emailed here via your SMTP config below.
ALERT_EMAIL=jgagliardo98@gmail.com

# SMTP — only needed if ALERT_EMAIL is set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
