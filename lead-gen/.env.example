# Apollo.io API Key
# Get yours at: https://app.apollo.io/#/settings/integrations/api
# NOTE: The people search endpoint requires a PAID Apollo plan (Basic or above).
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — Spreadsheet ID
# The ID is in your spreadsheet's URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_IS_HERE/edit
GOOGLE_SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# Name of the sheet tab to write to (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Google Service Account credentials — choose ONE of the two options below:

# Option A: Inline JSON (useful for hosted environments, CI/CD, etc.)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option B: Path to the downloaded credentials JSON file (local development)
GOOGLE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account-credentials.json

# Email to receive error alerts (currently logged to console; see SETUP.md to enable email)
ALERT_EMAIL=jgagliardo98@gmail.com
