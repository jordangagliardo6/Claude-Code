# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
# Note: Phone number access requires a Basic plan or higher.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets / Drive ────────────────────────────────────────────────────
# Path to your Google service account credentials JSON file.
# See SETUP.md for step-by-step instructions to create one.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Optional: Override the spreadsheet ID from config.js ────────────────────
# SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8
