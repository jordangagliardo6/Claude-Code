# ══════════════════════════════════════════════════════════════════════════════
# HVAC Lead-Gen — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below.
# 3. NEVER commit .env to version control.
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Apollo.io ─────────────────────────────────────────────────────────────────
# Find your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the sheet tab to write data to (defaults to "Leads" if not set)
GOOGLE_SHEET_NAME=Leads

# ── Google Auth — Option A: Service Account (RECOMMENDED for automation) ──────
#
# Steps:
#   1. Go to https://console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Create a service account, generate a JSON key, download it
#   3. Enable the Google Sheets API in your project
#   4. Open your spreadsheet → Share → add the service-account email (Editor)
#   5. Set the path below to the downloaded JSON file
#
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ── Google Auth — Option B: OAuth2 (for personal Google account) ──────────────
# Use ONLY if you are NOT using a service account.
# Comment out GOOGLE_SERVICE_ACCOUNT_KEY_FILE above and fill these in.
#
# Steps:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth2 Client ID (Desktop app)
#   3. Download the credentials JSON; note the client_id and client_secret
#   4. Run the Google OAuth2 playground to generate a refresh token, or
#      add a one-time OAuth flow to setup.js (uncomment the section there)
#
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# ── Alerts (optional) ──────────────────────────────────────────────────────────
# If set, workflow errors will be logged to console with this email flagged.
# To actually send emails, install nodemailer and uncomment the sendMail block
# in src/workflow.js → notify().
ALERT_EMAIL=your_email@example.com

# ── SMTP settings (only needed if you enable nodemailer in workflow.js) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ── Scheduler overrides (optional) ────────────────────────────────────────────
# Default: 7:00 AM Eastern Time every day.
# Change CRON_SCHEDULE to any valid cron expression.
# Examples:
#   Every day at 7am ET:   0 7 * * *   (default)
#   Weekdays only at 8am:  0 8 * * 1-5
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=America/New_York
