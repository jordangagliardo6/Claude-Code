# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Copy the ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Auth — choose ONE of the three options below:

# OPTION A (recommended for automation): Paste the full JSON contents of your
# service account key (single line, no newlines inside the JSON string).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OPTION B: Path to a service account key file on disk
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json

# OPTION C: Path to an OAuth2 credentials file (personal Google account flow)
# GOOGLE_CREDENTIALS_FILE=./oauth-credentials.json

# ─── Error Notifications ──────────────────────────────────────────────────────
# Email address to receive alerts when a run fails
NOTIFICATION_EMAIL=your@email.com

# SMTP settings (needed for email alerts — see README for Gmail setup)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password
