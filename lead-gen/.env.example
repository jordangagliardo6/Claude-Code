# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your sheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google service account JSON credentials file
# (see credentials/SETUP.md for how to create this)
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Name of the tab inside your spreadsheet (default: Leads)
GOOGLE_SHEET_TAB=Leads

# ─── Notifications ─────────────────────────────────────────────────────────────
# Email to send error alerts to (your Gmail address)
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail address to send FROM (can be same as above)
GMAIL_USER=jgagliardo98@gmail.com

# Gmail App Password (NOT your regular password)
# Create at: myaccount.google.com → Security → App Passwords
# Set to "disabled" to skip email alerts and use console-only logging
GMAIL_APP_PASSWORD=disabled

# ─── Schedule ─────────────────────────────────────────────────────────────────
# Cron expression — default: 7:00 AM Eastern Time daily
# node-cron uses server local time; if your server is UTC, use "0 12 * * *"
# If your server is in Eastern Time, "0 7 * * *" is correct
CRON_SCHEDULE=0 7 * * *

# Timezone for the cron job (uses TZ database names)
CRON_TIMEZONE=America/New_York

# Max new leads to add per run (keep low to stay manageable)
MAX_LEADS_PER_RUN=25
