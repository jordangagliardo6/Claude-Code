# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get this from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID between /d/ and /edit in your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the spreadsheet where leads will be written
SHEET_TAB_NAME=Leads

# Path to the Google service account credentials JSON you downloaded
GOOGLE_SERVICE_ACCOUNT_FILE=./google-credentials.json

# ─── Error alerts (optional but recommended) ─────────────────────────────────
# Where to send error emails
ALERT_EMAIL=your_email@gmail.com

# Gmail account used to SEND the alert (must be the same Gmail you generate an App Password for)
SMTP_USER=your_gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password):
#   myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_PASS=your_16_char_app_password_here
