# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Your Apollo API key — find it at https://developer.apollo.io/keys
# Note: the People Search endpoint (used here) requires a paid Apollo plan.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# Path to the service-account JSON file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Spreadsheet ID — from the URL: docs.google.com/spreadsheets/d/<ID>/edit
# Your existing sheet: 15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU
GOOGLE_SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# Tab name inside the spreadsheet (default: "Sheet1")
SHEET_NAME=Sheet1

# ─── Notifications ────────────────────────────────────────────────────────────
# Email address to send error alerts to
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional: SMTP credentials for email alerts (Gmail works well here)
# If not set, errors are logged to the console only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_app_password   # Use a Gmail App Password, not your real password

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Max new leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25

# Set to "true" to log rows without actually writing to the sheet
DRY_RUN=false
