# Apollo.io API Key
# Get yours at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the spreadsheet ID to append leads to
# Find this in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# The "SW Michigan HVAC Leads" sheet is already created in your Drive:
GOOGLE_SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# Google OAuth credentials file path (generated by setup-auth.js)
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Max leads to pull per daily run (default: 25)
MAX_LEADS_PER_RUN=25

# Your email for error notifications (used if you add SendGrid/SMTP later)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
