# Apollo.io API Key
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Drive / Sheets credentials
# Path to your downloaded service account JSON file (see setup guide)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# OR paste the service account JSON inline as a single-line string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# The ID of your Google Spreadsheet
# Found in the sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Leads

# Email alert settings (optional — leave blank to skip email alerts)
# Uses Gmail SMTP; generate an App Password at https://myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=

# Max leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — default is 7:00 AM Eastern (12:00 UTC)
# Adjust if you observe Daylight Saving Time (EDT = UTC-4, 11:00 UTC; EST = UTC-5, 12:00 UTC)
CRON_SCHEDULE=0 11 * * *
