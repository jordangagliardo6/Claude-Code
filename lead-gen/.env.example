# ─── Apollo.io ─────────────────────────────────────────────────────────────────
# Get your API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ──────────────────────────────────────────────────────────────
# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# OR paste the entire credentials JSON as a single-line string (for hosted environments)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# The spreadsheet ID from the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: which sheet tab to write to (defaults to Sheet1)
# SHEET_TAB_NAME=Sheet1

# ─── Error Notifications ────────────────────────────────────────────────────────
# Your email address to receive error alerts
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail credentials for sending alert emails (uses app password, not your login password)
# Generate at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_FROM=your_gmail@gmail.com
NOTIFY_EMAIL_PASSWORD=your_gmail_app_password
