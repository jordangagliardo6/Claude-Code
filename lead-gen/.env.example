# Apollo.io API Key — get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Optional: email address for error alerts (future use)
ALERT_EMAIL=your@email.com

# Sheet tab name (defaults to Sheet1 if not set)
SHEET_TAB_NAME=Leads
