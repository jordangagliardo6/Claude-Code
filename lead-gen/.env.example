# Apollo.io API key — get this from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Sheet tab name (the "Untitled" or renamed sheet tab)
SHEET_NAME=Untitled

# Error notification — the email address to alert if a run fails
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail credentials for sending error alerts (App Password recommended)
# Enable at: https://myaccount.google.com/apppasswords
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Max leads to pull per run (keep low so the list stays manageable)
MAX_LEADS_PER_RUN=25
