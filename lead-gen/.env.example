# ─────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────
# Get this from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The long ID in your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Absolute path to the service account JSON key file you downloaded
# from Google Cloud Console (see README for setup steps)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account-key.json

# ─────────────────────────────────────────────
# Notifications (optional)
# ─────────────────────────────────────────────
# Email address to receive error alerts.
# Leave blank to disable email alerts (errors will still log to console).
ALERT_EMAIL=you@example.com

# Gmail address used to SEND the alert emails (must be the same account
# whose App Password is below).
GMAIL_USER=yourgmail@gmail.com

# Gmail App Password (NOT your regular password).
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────
# Maximum leads to pull per scheduled run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule in America/New_York timezone (default: 7:00am every day)
CRON_SCHEDULE=0 7 * * *
