# ── Required ─────────────────────────────────────────────────────────────────

# Apollo.io API key — get it at https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheet ID — the long string in your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google service account JSON key file
# See the README for how to create one. Keep this file out of version control.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Optional: email alerts on errors ─────────────────────────────────────────
# Leave these blank to skip email notifications (errors still go to error.log).

# Your email address for error alerts
NOTIFY_EMAIL=

# SMTP settings — Gmail example shown; adjust for your provider.
# For Gmail, use an App Password (not your regular password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
