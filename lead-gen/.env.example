# Apollo.io API Key
# Get this from: https://developer.apollo.io/keys/
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Sheets tab name (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google Service Account credentials JSON file
# See README for how to create this
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Alert email — used in error logs so you know who to notify
# (Console logging is the primary alert method; swap for nodemailer if needed)
ALERT_EMAIL=your_email@example.com

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Timezone for scheduler (default: America/New_York for Eastern Time)
TIMEZONE=America/New_York
