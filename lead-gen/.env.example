# Apollo.io API Key
# Get yours at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets Spreadsheet ID
# Found in the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Sheets tab/sheet name (default: Sheet1)
GOOGLE_SHEET_TAB_NAME=Leads

# Path to your Google service account credentials JSON file
# OR use GOOGLE_CREDENTIALS_JSON to inline the JSON string
GOOGLE_CREDENTIALS_FILE=./google-credentials.json

# Optional: inline JSON credentials (base64-encoded) instead of a file
# GOOGLE_CREDENTIALS_JSON=

# Notification email for error alerts (optional)
NOTIFICATION_EMAIL=your_email@example.com

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Timezone for scheduler (default: America/New_York for 7am ET)
SCHEDULER_TIMEZONE=America/New_York
