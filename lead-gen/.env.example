# ──────────────────────────────────────────────
#  Apollo.io
# ──────────────────────────────────────────────
# Get your API key from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ──────────────────────────────────────────────
#  Google Sheets
# ──────────────────────────────────────────────
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Paste the ENTIRE contents of your service account JSON key file here,
# on a single line. See README for how to create a service account.
# Example shape (replace all values):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-project","private_key_id":"abc123","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"lead-gen@my-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_SERVICE_ACCOUNT_JSON=

# ──────────────────────────────────────────────
#  Error Notifications
# ──────────────────────────────────────────────
# Email address to receive error alerts
NOTIFY_EMAIL=jgagliardo98@gmail.com

# SMTP settings — required only if you want email alerts on errors.
# Gmail users: use an App Password (not your real password).
#   Generate at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com
