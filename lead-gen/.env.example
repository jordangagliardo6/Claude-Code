# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your key from: https://developer.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab/sheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google service account key JSON file
# See setup.js instructions for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/serviceAccountKey.json

# ─── Error Notifications (optional) ──────────────────────────────────────────
# If set, email errors to this address using the SMTP settings below.
# Leave blank to disable email notifications (errors still log to console).
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP (or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
# For Gmail, use an App Password (not your regular password).
# Create one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
