# ── Apollo.io ──────────────────────────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────────────────────
# The ID of your Google Spreadsheet (from its URL: .../spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google service account JSON credentials file
# (download from Google Cloud Console → IAM & Admin → Service Accounts → Keys)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# ── Email Notifications (optional) ─────────────────────────────────────────────
# If set, errors will be emailed here. Leave blank to only log to console.
NOTIFY_EMAIL=jgagliardo98@gmail.com

# Gmail app password for sending error alerts
# (Google Account → Security → App Passwords → generate one for "Mail")
GMAIL_APP_PASSWORD=your_gmail_app_password_here
GMAIL_FROM=jgagliardo98@gmail.com

# ── Run Config ──────────────────────────────────────────────────────────────────
# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule: "0 7 * * *" = 7:00 AM every day
# Uses America/New_York timezone (Eastern Time)
CRON_SCHEDULE=0 7 * * *
