# Apollo.io REST API key — find it at app.apollo.io > Settings > Integrations > API
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the spreadsheet to append leads to
# Get this from the spreadsheet URL: /spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=1bTcYo6cfs2aTMbjzyD15FBMH3IQMGJP2Mt4MACJq6t8

# The tab name inside the spreadsheet (check the bottom tab)
GOOGLE_SHEET_NAME=Untitled

# Path to your Google service account JSON key file
# See README.md for how to create one
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json

# Optional: your email address for error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Optional: Gmail App Password for sending error alerts
# Create one at myaccount.google.com > Security > App Passwords
GMAIL_USER=jgagliardo98@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Max leads to pull per run (default: 25)
MAX_LEADS_PER_RUN=25

# Cron schedule — "0 7 * * *" = 7:00 AM every day
# Timezone is always America/New_York (Eastern)
CRON_SCHEDULE=0 7 * * *
