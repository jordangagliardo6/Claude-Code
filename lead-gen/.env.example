# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get this from https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab name inside your spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account JSON key file (see README for setup)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials.json

# ─── Notifications ────────────────────────────────────────────────────────────
# Email to notify on errors (optional — errors are always logged to console)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP credentials for sending error alerts (optional)
# Use an App Password if you have 2FA: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
