# ──────────────────────────────────────────────
# Apollo.io
# ──────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ──────────────────────────────────────────────
# Google Sheets
# The spreadsheet ID is in the URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# ──────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to your Google service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# ──────────────────────────────────────────────
# Error notifications (optional — leave blank to skip email alerts)
# ──────────────────────────────────────────────
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# SMTP settings for outgoing email alerts (Gmail example shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# ──────────────────────────────────────────────
# Workflow settings (optional overrides)
# ──────────────────────────────────────────────
MAX_LEADS_PER_RUN=25
CRON_SCHEDULE=0 7 * * *
TIMEZONE=America/New_York
