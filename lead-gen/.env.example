# ── Apollo.io ──────────────────────────────────────────────────
# Get your API key from: https://app.apollo.io/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────
# The spreadsheet ID is the long string in the URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service-account credentials JSON file.
# Default: ./credentials.json (in the lead-gen folder)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Email Alerts (optional) ─────────────────────────────────────
# If set, an email is sent whenever a run errors out.
# Leave blank to receive console-only error logs.
ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# For Gmail, use an App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
