# Apollo.io API key — get from app.apollo.io > Settings > Integrations > API
# NOTE: The people search endpoint requires a paid Apollo plan (Basic $49/mo or higher)
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the spreadsheet to write leads into
# Your existing "SW Michigan HVAC Leads" sheet ID:
GOOGLE_SHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Path to your Google Service Account JSON key file
# See README setup step for how to create this
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Email to notify on errors
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP credentials for error emails (Gmail example below)
# Use an App Password if 2FA is on: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
