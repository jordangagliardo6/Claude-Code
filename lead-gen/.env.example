# ─────────────────────────────────────────────────────────────────
# HVAC Lead Gen — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to git — it's already in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Apollo.io ──────────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ───────────────────────────────────────────────
# Path to your service account JSON key file (see SETUP.md Step 2)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# The spreadsheet ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ── Error Notifications (optional but recommended) ──────────────
# Email address to receive error alerts
ALERT_EMAIL=your_email@example.com

# SMTP credentials for sending alert emails
# Gmail example: use an App Password (not your regular password)
#   https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
