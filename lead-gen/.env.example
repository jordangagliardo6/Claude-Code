# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Found at: https://developer.apollo.io/ → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to your downloaded service-account JSON file (see README for setup steps)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# The spreadsheet ID from the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Name of the tab inside your spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Sheet1

# ─── Email Alerts (optional) ──────────────────────────────────────────────────
# If set, errors will be emailed in addition to being logged to the console.
# Use Gmail App Password (not your account password): myaccount.google.com → Security → App passwords
ALERT_EMAIL_TO=jgagliardo98@gmail.com
ALERT_EMAIL_FROM=jgagliardo98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jgagliardo98@gmail.com
SMTP_PASS=your_gmail_app_password_here
