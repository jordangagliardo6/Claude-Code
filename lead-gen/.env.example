# ── Apollo.io ──────────────────────────────────────────────
# Get your key at: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Sheets ──────────────────────────────────────────
# Copy the Sheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your downloaded Google service-account JSON key file
# (see setup-test.js for instructions on creating one)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Name of the tab inside your spreadsheet (default: Sheet1)
SHEET_TAB_NAME=Leads

# ── Notifications ──────────────────────────────────────────
# Email address to notify when a run fails
ALERT_EMAIL=your_email@gmail.com

# Gmail address used to send the alert (can be the same account)
GMAIL_USER=your_gmail@gmail.com

# Gmail App Password (not your regular password)
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Run settings ───────────────────────────────────────────
# How many leads to pull per run (keep ≤ 25 to stay manageable)
MAX_LEADS_PER_RUN=25

# Cron schedule: "0 7 * * *" = 7:00 AM every day
# The TZ env var below pins it to Eastern Time
CRON_SCHEDULE=0 7 * * *
TZ=America/New_York
