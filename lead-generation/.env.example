# ============================================================
# HVAC Lead Generation — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Apollo.io API Key (requires Basic plan or higher for API access)
# Get yours at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google OAuth2 Credentials JSON (from Google Cloud Console)
# Steps: console.cloud.google.com → New Project → Enable "Google Sheets API"
#        → Credentials → Create → OAuth 2.0 Client ID (Desktop App)
#        → Download JSON → paste the ENTIRE file contents here as one line
GOOGLE_CREDENTIALS={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"]}}

# Google Spreadsheet ID (from the URL of your sheet)
# Current target: "SW Michigan HVAC Leads — New Sept 8 2026"
SPREADSHEET_ID=15DJVZJiMnbt6tdF6e2RMcGY6_M1JrjxomiIJJPJykhU

# Notification email for errors (defaults to this address)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# ---- OPTIONAL: Email alerts on errors ----
# If not set, errors are logged to error.log only
# Use Gmail app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
