# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead Generation — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Apollo.io API key — get yours at app.apollo.io > Settings > Integrations > API
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — ID of the spreadsheet to write leads into.
# The ID is the long string in the sheet URL between /d/ and /edit:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
# Your current sheet: HVAC SW Michigan Leads
GOOGLE_SPREADSHEET_ID=1Ox2uM8KR-_Fe-CIFrkGRdXMLQFnASqXXSaVCrzzao2o

# Name of the tab inside the spreadsheet (default: Sheet1)
SHEET_NAME=Sheet1

# Path to your Google service account credentials JSON file.
# Download from Google Cloud Console > IAM > Service Accounts > Keys > Add Key > JSON
# Then share the spreadsheet with the service account email address.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Email address to receive error alerts
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# ─── Optional: SMTP email alerts ─────────────────────────────────────────────
# Leave these blank to use console-only error logging.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com
# Gmail requires an App Password (not your regular password):
#   myaccount.google.com > Security > 2-Step Verification > App Passwords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
