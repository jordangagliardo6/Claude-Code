# ─── Apollo.io ───────────────────────────────────────────────────────────────
# Get this from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The ID is in the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab name inside your spreadsheet (usually "Sheet1")
GOOGLE_SHEET_NAME=Sheet1

# ─── Error Notifications ─────────────────────────────────────────────────────
# Email address to send error alerts to
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# SMTP settings for sending email alerts (Gmail example below)
# For Gmail: use an App Password (not your real password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Workflow Settings ────────────────────────────────────────────────────────
# Maximum new leads to add per run (default: 25)
MAX_LEADS_PER_RUN=25
