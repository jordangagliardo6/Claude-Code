# Apollo.io API key — get from https://developer.apollo.io → API Keys
# Requires Apollo Basic plan ($49/mo) or higher for People Search
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID — copy from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=1zLEBSyH0m0DBGw3E_6yC48tYojGKBR6JoD1DwFpUjrs

# Google Service Account credentials JSON file path
# See README for how to create a service account and download the JSON
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json

# Email to notify when the workflow errors (uses Gmail SMTP by default)
NOTIFICATION_EMAIL=jgagliardo98@gmail.com

# Gmail SMTP credentials for error alerts (use an App Password, not your real password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=jgagliardo98@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Max leads to add per run (default 25)
MAX_LEADS_PER_RUN=25
