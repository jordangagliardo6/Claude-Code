# ──────────────────────────────────────────────────────────────────
# Apollo.io Lead Generator — Environment Variables
# Copy this file to .env and fill in your values before running.
# ──────────────────────────────────────────────────────────────────

# Apollo.io API key — get it from https://developer.apollo.io → API Keys
# NOTE: People Search requires a Basic plan ($49/mo) or higher.
# Free plan only supports People Enrichment (50 contacts/month).
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets — the ID of the spreadsheet to append leads to.
# Pull this from the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
#
# Current active sheet (SW Michigan HVAC Leads — New Sept 21 2026):
GOOGLE_SHEET_ID=1Cd_BUAlAogk73VfJMF4tPWIhofjMjPWMfA2byy5o6II

# Path to your Google service account JSON file.
# See SETUP.md → Step 2 for how to create this.
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# The tab name inside the spreadsheet (default: Sheet1).
# If your sheet tab is named something else, update this.
SHEET_TAB_NAME=Sheet1

# Email address to receive error alerts.
ALERT_EMAIL=jgagliardo98@gmail.com

# ── Optional: Email alerts via Gmail SMTP ──────────────────────
# Only needed if you want email notifications on errors.
# App password: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# Max leads to pull per run (default: 25).
MAX_LEADS_PER_RUN=25
