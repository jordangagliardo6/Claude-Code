# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Get your API key from https://developer.apollo.io → API Keys
# Note: The people search API requires a paid plan (Basic $49/mo or higher)
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=1dwSkfx0AifqG4PYfiJlu36HO9-9r-30S7-IkvMKP8zk

# ─── Google Auth — choose ONE of the two options below ────────────────────────

# Option A: Service Account (recommended for unattended/scheduled scripts)
# Download the JSON key from Google Cloud Console → IAM → Service Accounts
# Then share the spreadsheet with the service account email address
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B: OAuth2 (if you ran the OAuth flow interactively)
# Place credentials.json (downloaded from Google Cloud Console) in this folder
# Then run: node auth.js   to generate google-token.json
# GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json
# GOOGLE_OAUTH_TOKEN_PATH=./google-token.json
