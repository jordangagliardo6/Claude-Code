# Copy this file to .env and fill in your real values. Never commit .env.

# Apollo.io
APOLLO_API_KEY=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Desktop app). See README.md for full steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Filled in automatically by `npm run authorize` (written to token.json).
# Set this instead if you'd rather not keep token.json around.
GOOGLE_REFRESH_TOKEN=

# The spreadsheet to append leads to. Grab the ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=
SHEET_NAME=Leads

# Error alerting (optional). If unset, errors only print to the console.
# EMAIL_USER must be a Gmail address with an App Password (not your normal password):
# https://myaccount.google.com/apppasswords
ALERT_EMAIL=
EMAIL_USER=
EMAIL_PASS=
