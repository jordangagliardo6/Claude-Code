# Copy this file to .env and fill in your own values. Never commit .env.

# --- Apollo.io ---
# Get this from developer.apollo.io -> Settings -> API
APOLLO_API_KEY=your_apollo_api_key_here

# --- Google OAuth (Sheets + Drive) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Application type: Desktop app). Enable the Google Sheets API and Google
# Drive API on the project first.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# The spreadsheet to append leads to. Copy the ID out of the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id
# Name of the tab/worksheet inside the spreadsheet
GOOGLE_SHEET_TAB=Leads

# --- Error alerts ---
# Where to email you if Apollo returns nothing or the Sheets write fails.
ALERT_EMAIL=jgagliardo98@gmail.com
# Gmail address + App Password (https://myaccount.google.com/apppasswords)
# used to send the alert email. Leave blank to log errors to console only.
SMTP_USER=
SMTP_PASS=
