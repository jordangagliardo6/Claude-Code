# Copy this file to .env and fill in your real values. Never commit .env.

# --- Apollo.io ---
# API key from https://app.apollo.io -> Settings -> Integrations -> API
APOLLO_API_KEY=

# Optional: a publicly reachable URL Apollo can POST to when it finishes a live
# mobile/direct-dial phone lookup (these lookups are async on Apollo's side).
# Leave blank to skip async phone reveals and only use phone numbers Apollo can
# return immediately. See README "Phone Numbers & Apollo Credits" section.
APOLLO_PHONE_WEBHOOK_URL=

# --- Google Sheets ---
# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Name of the tab/worksheet inside that spreadsheet to read/append
GOOGLE_SHEET_TAB_NAME=Leads

# Paths to the OAuth client file you download from Google Cloud Console and the
# token file generated the first time you run `npm run auth` (defaults are fine).
GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json
GOOGLE_OAUTH_TOKEN_PATH=./token.json

# --- Workflow limits ---
MAX_NEW_LEADS_PER_RUN=25

# --- Schedule (cron expression, evaluated in America/New_York time) ---
CRON_SCHEDULE=0 7 * * *

# --- Error alert email (optional but recommended) ---
# Sent only when a run fails (Apollo error / no results / Sheets write failure).
# Uses a standard SMTP account. For Gmail, create an "App Password" at
# https://myaccount.google.com/apppasswords (regular Gmail password will NOT work).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
