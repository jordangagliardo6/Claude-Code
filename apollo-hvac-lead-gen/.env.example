# ─────────────────────────────────────────────────────────────
# Apollo.io
# ─────────────────────────────────────────────────────────────
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────────────────────
# Found in the spreadsheet URL:
#   docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to the Google service account credentials JSON file
# (downloaded from Google Cloud Console → IAM → Service Accounts → Keys)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# ─────────────────────────────────────────────────────────────
# Workflow settings
# ─────────────────────────────────────────────────────────────
# Max new leads to add per scheduled run (keeps the list manageable)
MAX_LEADS_PER_RUN=25

# ─────────────────────────────────────────────────────────────
# Email alerts — OPTIONAL
# ─────────────────────────────────────────────────────────────
# Leave ALL of these blank if you only want console/file logging.
# Fill them ALL in if you want email notifications on errors.
#
# For Gmail: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_EMAIL=your-alert-destination@gmail.com
