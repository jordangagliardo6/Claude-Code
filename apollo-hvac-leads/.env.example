# ─────────────────────────────────────────────────────────────────────────────
# Apollo.io
# Get your API key at: https://developer.apollo.io → API Keys
# ─────────────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets auth — CHOOSE ONE method:
#
# OPTION A (recommended for scheduled tasks): Service Account
#   1. Go to https://console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Create a service account, download the JSON key
#   3. Save the file as  service-account-key.json  in this folder
#   4. Share your spreadsheet with the service account email (Editor access)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# OPTION B: OAuth2 (if you prefer user credentials)
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Desktop app type)
#   3. Run:  node get-oauth-token.js  to generate a refresh token
# GOOGLE_CLIENT_ID=your_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# ─────────────────────────────────────────────────────────────────────────────
# Error notification email (optional — alerts you if a run fails)
# Uses Gmail SMTP: enable "App Passwords" at myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL=jgagliardo98@gmail.com
# SMTP_USER=jgagliardo98@gmail.com
# SMTP_PASS=your_gmail_app_password_here
