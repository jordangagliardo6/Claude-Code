# ─── Apollo.io ─────────────────────────────────────────────────────────────────
# Required. Get your key at: https://developer.apollo.io → Settings → API Keys
# IMPORTANT: People search requires Apollo Basic plan or higher ($49/mo).
# Free plan API keys will fail with "API_INACCESSIBLE" on the search step.
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# Spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
# Pre-filled with the "SW Michigan HVAC Leads" sheet already in your Drive.
GOOGLE_SHEET_ID=1Z2CrAggrULqpiZSTDlG5muIxaO4SCSjdIUo-Do_sEus

# Tab name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Path to your Google Service Account credentials JSON file.
# See setup steps below for how to create this file.
GOOGLE_CREDENTIALS_FILE=credentials.json

# ─── Scheduling ────────────────────────────────────────────────────────────────
# Timezone for cron. America/New_York = Eastern Time (handles DST automatically)
TZ=America/New_York

# Override the cron expression if you want a different schedule.
# Default '0 7 * * *' = every day at 7:00 AM Eastern.
# CRON_SCHEDULE=0 7 * * *

# ─── Optional: Email alerts ────────────────────────────────────────────────────
# Uncomment and fill in if you want email notifications on errors.
# Also uncomment the nodemailer block inside index.js notifyError().
# ALERT_EMAIL=you@gmail.com
# ALERT_EMAIL_PASSWORD=your_gmail_app_password


# ═══════════════════════════════════════════════════════════════════════════════
# HOW TO CREATE A GOOGLE SERVICE ACCOUNT (one-time setup)
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select an existing one)
# 3. Enable the Google Sheets API:
#    APIs & Services → Library → search "Google Sheets API" → Enable
# 4. Create a Service Account:
#    APIs & Services → Credentials → Create Credentials → Service Account
#    - Name it anything (e.g. "hvac-lead-gen")
#    - Skip optional role and user steps
#    - Click Done
# 5. Generate a JSON key:
#    Click the service account → Keys tab → Add Key → Create new key → JSON
#    Download the file and rename it credentials.json
#    Place it in this folder (apollo-hvac-leads/)
# 6. Share the spreadsheet with the service account:
#    Open the "SW Michigan HVAC Leads" sheet in Google Drive
#    Click Share → paste the service account email (ends in @...iam.gserviceaccount.com)
#    Set role to Editor → Done
#
# That's it — the code will authenticate automatically using this file.
