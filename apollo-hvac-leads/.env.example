# Apollo.io API key — get it from https://developer.apollo.io → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# The ID from your Google Spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Your email for error notifications (console-logged; swap in an SMTP lib to send real emails)
NOTIFICATION_EMAIL=you@example.com

# Name of the tab inside your spreadsheet (default: Leads)
SHEET_NAME=Leads
